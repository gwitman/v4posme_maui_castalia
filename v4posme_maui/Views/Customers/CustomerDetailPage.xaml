<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:dxcn="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             x:Class="v4posme_maui.Views.Customers.CustomerDetailPage"
             Style="{StaticResource DetailPageStyle}">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding EditCommand}" Text="Edit"
                     IconImageSource="{AppThemeBinding Light=edit, Dark=edit}" />
        <ToolbarItem Clicked="DeleteItemClick" Text="Delete"
                     IconImageSource="{AppThemeBinding Light=delete, Dark=delete}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <ScrollView>
            <dx:DXStackLayout Orientation="Vertical" Padding="0,0,0,20">

                <!-- Encabezado -->
                <dx:DXBorder BackgroundColor="{StaticResource Primary}"
                             CornerRadius="0,0,28,28"
                             BorderThickness="0"
                             Padding="0,20,0,28">
                    <dx:DXStackLayout Orientation="Vertical" HorizontalOptions="Center">
                        <dx:DXBorder WidthRequest="120"
                                     HeightRequest="120"
                                     CornerRadius="60"
                                     BorderThickness="0"
                                     HorizontalOptions="Center"
                                     BackgroundColor="#33FFFFFF">
                            <dx:DXImage Source="person_charge"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Aspect="AspectFit" />
                        </dx:DXBorder>
                        <Label Text="{Binding Item.EntityId}"
                               FontSize="24"
                               TextColor="White"
                               Margin="0,12,0,0"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold" />
                        <Label Text="{Binding Item.Identification}"
                               HorizontalTextAlignment="Center"
                               TextColor="White"
                               Opacity="0.9"
                               FontSize="16" />
                    </dx:DXStackLayout>
                </dx:DXBorder>

                <dx:DXBorder Style="{StaticResource PropertyBorder}" Margin="14,16,14,8">
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="Nombres" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Item.FirstName}" FontSize="18" Margin="0,2,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
                <dx:DXBorder Style="{StaticResource PropertyBorder}" Margin="14,8">
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="Apellidos" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Item.LastName}" FontSize="18" Margin="0,2,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
                <dx:DXBorder Style="{StaticResource PropertyBorder}" Margin="14,8">
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="Dirección" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Item.Location}" FontSize="18" Margin="0,2,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
                <dx:DXBorder Style="{StaticResource PropertyBorder}" Margin="14,8">
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="Celular" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Item.Phone}" FontSize="18" Margin="0,2,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
                <dx:DXBorder Style="{StaticResource PropertyBorder}" Margin="14,8">
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="Balance" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="13" />
                        <Label Text="{Binding Item.Balance}" FontSize="20" FontAttributes="Bold" Margin="0,2,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>

                <dxcn:DXPopup x:Name="Popup" AllowScrim="True"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Stretch"
                              Margin="16" CornerRadius="16"
                              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                    <dx:DXStackLayout Orientation="Vertical" Padding="10">
                        <Label Text="¿Seguro quiere eliminar este cliente? Está acción no se puede revertir"
                               Margin="0,20"
                               HorizontalTextAlignment="Center"
                               FontAttributes="Bold" />
                        <dx:DXBorder Style="{StaticResource SeparatorStyle}" />
                        <dx:DXButton Content="Eliminar"
                                     Icon="delete"
                                     Clicked="DeleteConfirmedClick"
                                     Style="{StaticResource PopupActionDeleteButtonStyle}" />
                        <dx:DXBorder Style="{StaticResource SeparatorStyle}" />
                        <dx:DXButton Content="Cancelar"
                                     Icon="cancel"
                                     Clicked="CancelDeleteClick"
                                     Style="{StaticResource PopupActionButtonStyle}" />
                    </dx:DXStackLayout>
                </dxcn:DXPopup>
            </dx:DXStackLayout>
        </ScrollView>
    </ContentPage.Content>
</ContentPage>
