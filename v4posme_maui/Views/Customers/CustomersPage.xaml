<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:local="clr-namespace:v4posme_maui.ViewModels"
             xmlns:models="clr-namespace:v4posme_maui.Models"
             Title="{Binding Title}"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:customers="clr-namespace:v4posme_maui.Views.Customers"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             x:Class="v4posme_maui.Views.Customers.CustomersPage">
    <ContentPage.BindingContext>
        <local:PosMeCustomerViewModel />
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="barcode_scan" Command="{Binding OnBarCode}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <converters:EstadoToColorConverter x:Key="EstadoToColorConverter" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <controls:ShimmerView
            Style="{StaticResource ShimmerEffect}"
            IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <Grid RowDefinitions="Auto,*">
                    <controls:DXPopup x:Name="Popup"
                                      AllowScrim="True"
                                      BackgroundColor="{Binding PopupBackgroundColor}"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Stretch"
                                      Margin="16"
                                      CornerRadius="16"
                                      ScrimColor="#b3adb9ce"
                                      IsOpen="{Binding PopUpShow}">
                        <StackLayout WidthRequest="250" Padding="4">
                            <Label Text="{Binding Mensaje}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource White}"
                                   Margin="20, 20" />
                            <Button Text="Aceptar"
                                    Clicked="ClosePopup_Clicked"
                                    BackgroundColor="{StaticResource Gray600}"
                                    CornerRadius="12"
                                    HeightRequest="46"
                                    FontSize="18"
                                    TextColor="White" />
                        </StackLayout>
                    </controls:DXPopup>

                    <!-- Barra de busqueda con tarjeta -->
                    <dxc:DXBorder Grid.Row="0"
                                  Margin="12,12,12,6"
                                  CornerRadius="16"
                                  BorderThickness="0"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}">
                        <dxc:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.18" Radius="14" Offset="0,4" />
                        </dxc:DXBorder.Shadow>
                        <dxe:TextEdit
                            x:Name="SearchBar"
                            Margin="6,2"
                            BackgroundColor="Transparent"
                            BoxMode="Outlined"
                            BorderThickness="0"
                            StartIcon="search"
                            StartIconColor="{StaticResource Primary}"
                            Text="{Binding Search}"
                            StartIconCommand="{Binding SearchCommand}"
                            ReturnCommand="{Binding SearchCommand}"
                            PlaceholderText="Buscar por código, identificación y nombres" />
                    </dxc:DXBorder>

                    <dxcv:DXCollectionView
                        x:Name="ClientesCollectionView"
                        Grid.Row="1"
                        Margin="0,0,0,0"
                        ItemsSource="{Binding Customers}"
                        DetailFormTemplate="{DataTemplate  customers:CustomerDetailPage}"
                        DetailEditFormTemplate="{DataTemplate customers:CustomerEditPage}"
                        DetailNewItemFormTemplate="{DataTemplate customers:CustomerEditPage}"
                        SelectedItem="{Binding SelectedCustomer}"
                        SelectionMode="Single"
                        AllowDragDropItems="True"
                        DropItem="ClientesCollectionView_OnDropItem"
                        IsLoadMoreEnabled="True"
                        LoadMoreCommand="{Binding LoadMoreCommand}"
                        TapCommand="{Binding Source={x:Reference ClientesCollectionView}, Path=Commands.ShowDetailForm}"
                        IsRefreshing="{Binding  IsBusy, Mode=TwoWay}">
                        <dxcv:DXCollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Api_AppMobileApi_GetDataDownloadCustomerResponse">
                                <dxc:DXBorder
                                    CornerRadius="18"
                                    BorderThickness="0"
                                    Padding="0"
                                    Margin="12,6">
                                    <dxc:DXBorder.Shadow>
                                        <Shadow Brush="{StaticResource Black}" Opacity="0.12" Radius="10" Offset="0,3" />
                                    </dxc:DXBorder.Shadow>
                                    <Grid
                                        HorizontalOptions="Fill"
                                        Padding="14"
                                        VerticalOptions="Fill">
                                        <Grid.BackgroundColor>
                                            <MultiBinding Converter="{StaticResource EstadoToColorConverter}">
                                                <Binding Path="Asignado" />
                                                <Binding Path="Facturado" />
                                            </MultiBinding>
                                        </Grid.BackgroundColor>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <dxc:DXBorder
                                            Grid.Column="0"
                                            Grid.RowSpan="4"
                                            WidthRequest="58"
                                            HeightRequest="58"
                                            CornerRadius="29"
                                            VerticalOptions="Center"
                                            BorderThickness="0"
                                            BackgroundColor="#33FFFFFF">
                                            <dxc:DXImage WidthRequest="40"
                                                         HeightRequest="40"
                                                         HorizontalOptions="Center"
                                                         VerticalOptions="Center"
                                                         Source="person_charge"
                                                         Aspect="AspectFit" />
                                        </dxc:DXBorder>

                                        <Label Grid.Column="1" Grid.Row="0" FontAttributes="Bold"
                                               Grid.ColumnSpan="2"
                                               Margin="12,0,0,0"
                                               FontSize="16"
                                               TextColor="White"
                                               Text="{Binding Identification}" />
                                        <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Margin="12,0,0,0">
                                            <Label Text="{Binding CustomerNumber}"
                                                   FontSize="13"
                                                   Opacity="0.9"
                                                   TextColor="White"
                                                   HorizontalOptions="Start" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Row="1" Grid.Column="2">
                                            <Label
                                                HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="Balance "
                                                              FontAttributes="Bold"
                                                              TextColor="White" />
                                                        <Span Text="{Binding CurrencyName}" TextColor="White" />
                                                        <Span Text="{Binding Balance, StringFormat='{0:N2}'}"
                                                              FontAttributes="Bold"
                                                              TextColor="White" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Row="2"
                                                               Grid.Column="1"
                                                               Margin="12,2,0,0"
                                                               Grid.ColumnSpan="2">
                                            <Label Text="{Binding FirstName}" FontSize="14" TextColor="White" />
                                            <Label Text=" " />
                                            <Label Text="{Binding LastName}" FontSize="14" TextColor="White" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="12,2,0,0"
                                            Grid.ColumnSpan="2">
                                            <Label
                                                Text="Línea de crédito: "
                                                FontSize="13"
                                                Opacity="0.9"
                                                TextColor="White" />
                                            <Label
                                                FontSize="13"
                                                Opacity="0.9"
                                                TextColor="White"
                                                Text="{Binding CustomerCreditLineId}" />
                                        </HorizontalStackLayout>
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                NumberOfTapsRequired="1"
                                                Command="{Binding Source={x:Reference ClientesCollectionView}, Path=Commands.ShowDetailForm}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                    </Grid>
                                </dxc:DXBorder>
                            </DataTemplate>
                        </dxcv:DXCollectionView.ItemTemplate>
                    </dxcv:DXCollectionView>

                    <Button Text="+"
                            Grid.Row="1"
                            WidthRequest="60"
                            HeightRequest="60"
                            FontSize="30"
                            CornerRadius="30"
                            FontAttributes="Bold"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            Command="{Binding Source={x:Reference ClientesCollectionView}, Path=Commands.ShowDetailNewItemForm}"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="20"
                            ZIndex="1">
                        <Button.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.5" Radius="16" Offset="0,4" />
                        </Button.Shadow>
                    </Button>
                </Grid>

            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>
