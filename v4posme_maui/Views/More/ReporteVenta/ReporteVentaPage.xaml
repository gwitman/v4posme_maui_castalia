<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:reporte="clr-namespace:v4posme_maui.ViewModels.More.ReporteVenta"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:models="clr-namespace:v4posme_maui.Models"
             Title="{Binding Title}"
             x:Class="v4posme_maui.Views.More.ReporteVenta.ReporteVentaPage"
             Style="{StaticResource DetailPageStyle}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>
    <Shell.PresentationMode>Animated</Shell.PresentationMode>

    <ContentPage.BindingContext>
        <reporte:ReporteVentaViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="basic_home_white" Clicked="BackToHome_OnClicked" />
        <ToolbarItem IconImageSource="shared_white" Command="{Binding HideFormCommand}" />
        <ToolbarItem Text="Imprimir" Order="Secondary" x:Name="ItemPrint_" Command="{Binding PrintCommand}" />
        <ToolbarItem Text="Compartir" Order="Secondary" Clicked="MenuItem_OnClicked" />
    </ContentPage.ToolbarItems>

    <ContentPage.Content>
        <controls:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <ScrollView>
                    <dx:DXStackLayout
                        x:Name="DxStackLayout_"
                        Orientation="Vertical"
                        BackgroundColor="{StaticResource PageBackground}"
                        Padding="16,16,16,24">

                        <!-- Date Filter -->
                        <Border StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CardColor}"
                                Padding="16"
                                Margin="0,0,0,12"
                                IsVisible="{Binding IsVisibleDate}">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <dxe:DateEdit x:Name="fechaInicio"
                                    DisplayFormat="d" StartIcon="editorscalendar"
                                    IconColor="{StaticResource Primary}"
                                    LabelText="Fecha Inicio" Grid.Column="0"
                                    Date="{Binding FechaInical}" />
                                <dxe:DateEdit x:Name="fechaFinal"
                                    DisplayFormat="d" StartIcon="editorscalendar"
                                    IconColor="{StaticResource Primary}"
                                    LabelText="Fecha Final" Grid.Column="1"
                                    Date="{Binding FechaFinal}" />
                            </Grid>
                        </Border>

                        <!-- Report Content -->
                        <VerticalStackLayout IsVisible="{Binding IsFormVisible}" Spacing="14">

                            <!-- Header Card -->
                            <Border StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource PrimaryDark}"
                                    Padding="20,24">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray400}" Offset="0,4" Radius="12" Opacity="0.35" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="{Binding Company.Name}"
                                           FontSize="18" FontFamily="OpenSansSemibold"
                                           HorizontalTextAlignment="Center" TextColor="White" />
                                    <Label Text="REPORTE DE CIERRE"
                                           FontSize="13" HorizontalTextAlignment="Center"
                                           TextColor="#B0C4DE" Margin="0,6,0,0" />
                                    <Label x:Name="reporteFecha"
                                           Text="{Binding ReporteFecha}"
                                           FontSize="12" HorizontalTextAlignment="Center"
                                           TextColor="#8FAABE" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Facturas C$ -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                                BackgroundColor="#E8F4FD" Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="FACTURA DE CONTADO C$"
                                                   FontSize="13" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </Grid>
                                    <dxcv:DXCollectionView x:Name="InvoicesCollectionView_1"
                                        ItemsSource="{Binding InvoicesNIO}"
                                        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                                        HeightRequest="{Binding InvoicesHeight_2}">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="models:ViewTempDtoReporteCierre"
                                                      Padding="4,6" ColumnDefinitions="*,Auto,Auto">
                                                    <Label Grid.Column="0" Text="{Binding DocumentNumber}"
                                                           FontSize="13" TextColor="{StaticResource Gray600}" />
                                                    <Label Grid.Column="1" Text="{Binding CurrencyName}"
                                                           FontSize="13" TextColor="{StaticResource Tertiary}"
                                                           Margin="0,0,6,0" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Remaining, StringFormat='{0:N2}'}"
                                                           FontSize="13" FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource PrimaryDark}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                             HorizontalOptions="Fill" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Total" FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalFacturaNIO}"
                                               FontSize="14" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Abonos C$ -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                                BackgroundColor="#E6F5ED" Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="ABONO C$"
                                                   FontSize="13" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Secondary}" />
                                        </Border>
                                    </Grid>
                                    <dxcv:DXCollectionView x:Name="InvoicesCollectionView_2"
                                        ItemsSource="{Binding CreditsNIO}"
                                        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                                        HeightRequest="{Binding CreditHeight_2}">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="models:ViewTempDtoReporteCierre"
                                                      Padding="4,6" ColumnDefinitions="*,Auto,Auto">
                                                    <Label Grid.Column="0" Text="{Binding DocumentNumber}"
                                                           FontSize="13" TextColor="{StaticResource Gray600}" />
                                                    <Label Grid.Column="1" Text="{Binding CurrencyName}"
                                                           FontSize="13" TextColor="{StaticResource Tertiary}"
                                                           Margin="0,0,6,0" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Remaining, StringFormat='{0:N2}'}"
                                                           FontSize="13" FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource PrimaryDark}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                             HorizontalOptions="Fill" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Total" FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalCreditoNIO}"
                                               FontSize="14" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Secondary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Facturas $ -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                                BackgroundColor="#E8F4FD" Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="FACTURA DE CONTADO $"
                                                   FontSize="13" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </Grid>
                                    <dxcv:DXCollectionView x:Name="InvoicesCollectionView_3"
                                        ItemsSource="{Binding InvoicesUS}"
                                        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                                        HeightRequest="{Binding InvoicesHeight}">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="models:ViewTempDtoReporteCierre"
                                                      Padding="4,6" ColumnDefinitions="*,Auto,Auto">
                                                    <Label Grid.Column="0" Text="{Binding DocumentNumber}"
                                                           FontSize="13" TextColor="{StaticResource Gray600}" />
                                                    <Label Grid.Column="1" Text="{Binding CurrencyName}"
                                                           FontSize="13" TextColor="{StaticResource Tertiary}"
                                                           Margin="0,0,6,0" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Remaining, StringFormat='{0:N2}'}"
                                                           FontSize="13" FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource PrimaryDark}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                             HorizontalOptions="Fill" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Total" FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalFactura}"
                                               FontSize="14" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Abonos $ -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                                BackgroundColor="#E6F5ED" Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="ABONO $"
                                                   FontSize="13" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Secondary}" />
                                        </Border>
                                    </Grid>
                                    <dxcv:DXCollectionView x:Name="InvoicesCollectionView_4"
                                        ItemsSource="{Binding CreditsUS}"
                                        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                                        HeightRequest="{Binding CreditHeight}">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="models:ViewTempDtoReporteCierre"
                                                      Padding="4,6" ColumnDefinitions="*,Auto,Auto">
                                                    <Label Grid.Column="0" Text="{Binding DocumentNumber}"
                                                           FontSize="13" TextColor="{StaticResource Gray600}" />
                                                    <Label Grid.Column="1" Text="{Binding CurrencyName}"
                                                           FontSize="13" TextColor="{StaticResource Tertiary}"
                                                           Margin="0,0,6,0" />
                                                    <Label Grid.Column="2"
                                                           Text="{Binding Remaining, StringFormat='{0:N2}'}"
                                                           FontSize="13" FontFamily="OpenSansSemibold"
                                                           TextColor="{StaticResource PrimaryDark}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                             HorizontalOptions="Fill" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="Total" FontSize="14"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalCredito}"
                                               FontSize="14" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Secondary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Totales Generales -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16,20">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,3" Radius="10" Opacity="0.3" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="RESUMEN GENERAL"
                                           FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource Tertiary}"
                                           HorizontalTextAlignment="Center" />
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}"
                                             HorizontalOptions="Fill" />
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                        <Label Grid.Column="0" Text="Total C$"
                                               FontSize="16" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalNIO}"
                                               FontSize="16" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                                        <Label Grid.Column="0" Text="Total $"
                                               FontSize="16" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Grid.Column="1" Text="{Binding TotalUSD}"
                                               FontSize="16" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Primary}"
                                               HorizontalTextAlignment="End" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Visitas -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource CardColor}"
                                    Padding="16">
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.25" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                                BackgroundColor="#FFF3E0" Padding="8,4"
                                                HorizontalOptions="Start">
                                            <Label Text="VISITAS"
                                                   FontSize="13" FontFamily="OpenSansSemibold"
                                                   TextColor="#E65100" />
                                        </Border>
                                    </Grid>
                                    <dxcv:DXCollectionView x:Name="InvoicesCollectionView_5"
                                        ItemsSource="{Binding Visits}"
                                        IsRefreshing="{Binding IsBusy, Mode=OneWay}"
                                        HeightRequest="{Binding VisitHeight}">
                                        <dxcv:DXCollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:DataType="models:ViewTempDtoReporteCierre"
                                                      Padding="4,6" ColumnDefinitions="*,Auto">
                                                    <Label Grid.Column="0" Text="{Binding ClientName}"
                                                           FontSize="13" TextColor="{StaticResource Gray600}"
                                                           LineBreakMode="TailTruncation" />
                                                    <Label Grid.Column="1" Text="{Binding Date}"
                                                           FontSize="12" TextColor="{StaticResource Tertiary}"
                                                           HorizontalTextAlignment="End" />
                                                </Grid>
                                            </DataTemplate>
                                        </dxcv:DXCollectionView.ItemTemplate>
                                    </dxcv:DXCollectionView>
                                </VerticalStackLayout>
                            </Border>

                        </VerticalStackLayout>
                    </dx:DXStackLayout>
                </ScrollView>
            </controls:ShimmerView.Content>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>
