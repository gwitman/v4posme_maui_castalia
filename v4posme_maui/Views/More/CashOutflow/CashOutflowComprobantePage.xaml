<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:cashoutflow="clr-namespace:v4posme_maui.ViewModels.More.CashOutflow"
             Title="{Binding Title}"
             x:Class="v4posme_maui.Views.More.CashOutflow.CashOutflowComprobantePage"
             BackgroundColor="{StaticResource PageBackground}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>

    <ContentPage.BindingContext>
        <cashoutflow:CashOutflowComprobanteViewModel />
    </ContentPage.BindingContext>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Ir a inicio" Order="Secondary" Clicked="BackToHome_OnClicked" />
        <ToolbarItem Text="Eliminar registro" Order="Secondary" Command="{Binding EliminarCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <dx:DXPopup x:Name="Popup"
                    AllowScrim="True"
                    BackgroundColor="{Binding PopupBackgroundColor}"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Margin="16"
                    CornerRadius="16"
                    ScrimColor="#b3adb9ce"
                    IsOpen="{Binding PopUpShow}">
            <StackLayout WidthRequest="250" Padding="4">
                <Label Text="{Binding Mensaje}"
                       FontAttributes="Bold"
                       FontSize="15"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource White}"
                       Margin="20, 20" />
                <Button Text="Aceptar"
                        Clicked="ClosePopup_Clicked"
                        BackgroundColor="{StaticResource Gray600}"
                        CornerRadius="12"
                        HeightRequest="46"
                        FontSize="18"
                        TextColor="White" />
            </StackLayout>
        </dx:DXPopup>

        <!-- Popup de confirmacion de eliminacion (con estilo) -->
        <dx:DXPopup x:Name="ConfirmDeletePopup"
                    AllowScrim="True"
                    BackgroundColor="{StaticResource CardColor}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch"
                    Margin="24"
                    CornerRadius="16"
                    ScrimColor="#b3adb9ce"
                    IsOpen="{Binding ConfirmarEliminarPopUpShow}">
            <VerticalStackLayout Padding="20" Spacing="14">
                <Label Text="Eliminar salida"
                       FontAttributes="Bold"
                       FontSize="17"
                       TextColor="{StaticResource PrimaryDark}"
                       HorizontalTextAlignment="Center" />
                <Label Text="¿Está seguro que desea eliminar esta salida? Esta acción no se puede deshacer."
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                    <Button Grid.Column="0"
                            Text="Cancelar"
                            BackgroundColor="{StaticResource Gray600}"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="46"
                            Command="{Binding CancelarEliminarCommand}" />
                    <Button Grid.Column="1"
                            Text="Eliminar"
                            BackgroundColor="#C62828"
                            TextColor="White"
                            CornerRadius="12"
                            HeightRequest="46"
                            Command="{Binding ConfirmarEliminarCommand}" />
                </Grid>
            </VerticalStackLayout>
        </dx:DXPopup>

        <dx:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <dx:ShimmerView.Content>
                <ScrollView>
                    <dx:DXStackLayout
                        x:Name="DxStackLayout_"
                        Orientation="Vertical"
                        BackgroundColor="{StaticResource PageBackground}"
                        Padding="16,16,16,24">

                        <!-- Confirmacion + numero de transaccion -->
                        <Border StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="#FDECEE"
                                Padding="20,18"
                                Margin="0,0,0,14">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="Comprobante de Salida"
                                       FontFamily="OpenSansSemibold" FontSize="16"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalTextAlignment="Center" />
                                <Label Text="No. de transacción"
                                       FontSize="12" Opacity="0.7"
                                       HorizontalTextAlignment="Center" Margin="0,6,0,0" />
                                <Label Text="{Binding Salida.NumeroSalida}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Detalle -->
                        <Border StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CardColor}"
                                Padding="18">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Gray300}" Offset="0,2" Radius="8" Opacity="0.3" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Fecha" FontSize="13" Opacity="0.7" />
                                    <Label Grid.Column="1" Text="{Binding Salida.Fecha, StringFormat='{0:dd/MM/yyyy hh:mm tt}'}"
                                           FontSize="13" HorizontalTextAlignment="End"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Moneda" FontSize="13" Opacity="0.7" />
                                    <Label Grid.Column="1" Text="{Binding Salida.MonedaNombre}"
                                           FontSize="13" HorizontalTextAlignment="End"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Comentario" FontSize="13" Opacity="0.7" />
                                    <Label Grid.Column="1" Text="{Binding Salida.Comentario}"
                                           FontSize="13" HorizontalTextAlignment="End"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Referencia 1" FontSize="13" Opacity="0.7" />
                                    <Label Grid.Column="1" Text="{Binding Salida.Referencia1}"
                                           FontSize="13" HorizontalTextAlignment="End"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Label Grid.Column="0" Text="Referencia 2" FontSize="13" Opacity="0.7" />
                                    <Label Grid.Column="1" Text="{Binding Salida.Referencia2}"
                                           FontSize="13" HorizontalTextAlignment="End"
                                           TextColor="{StaticResource PrimaryDark}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Total -->
                        <Border StrokeShape="RoundRectangle 14"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource CardColor}"
                                Padding="20,16"
                                Margin="0,14,0,0">
                            <Border.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="12" Offset="0,4" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="Monto de la salida" FontSize="13" Opacity="0.7"
                                       HorizontalOptions="Center" />
                                <Label Text="{Binding Salida.MontoFormateado}"
                                       FontSize="34" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Acciones -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,20,0,0">
                            <dx:SimpleButton Grid.Column="0"
                                             Text="Imprimir"
                                             Icon="printer"
                                             BackgroundColor="{StaticResource Primary}"
                                             TextColor="White"
                                             Command="{Binding ImprimirCommand}" />
                            <dx:SimpleButton Grid.Column="1"
                                             Text="Compartir"
                                             Icon="shared_white"
                                             BackgroundColor="{StaticResource PrimaryDark}"
                                             TextColor="White"
                                             Command="{Binding CompartirCommand}" />
                        </Grid>

                        <dx:SimpleButton Text="Nueva Salida"
                                         Margin="0,12,0,0"
                                         BackgroundColor="Transparent"
                                         BorderColor="{StaticResource Primary}"
                                         BorderThickness="1"
                                         TextColor="{StaticResource Primary}"
                                         Command="{Binding NuevaSalidaCommand}" />

                        <Button Text="Subir Datos"
                                Command="{Binding Sync.MostrarConfirmacionSubidaCommand}"
                                BackgroundColor="#E67E22"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                Margin="0,12,0,0" />

                    </dx:DXStackLayout>
                </ScrollView>
            </dx:ShimmerView.Content>
        </dx:ShimmerView>

        <!-- Popup de confirmacion de subida (estilo de marca posMe) -->
        <dx:DXPopup x:Name="ConfirmarSubidaPopup"
                    AllowScrim="True"
                    BackgroundColor="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="20"
                    ScrimColor="#99000000"
                    IsOpen="{Binding Sync.MostrarConfirmacionSubida}">
            <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                             HorizontalOptions="Center" BackgroundColor="#FDF0E3">
                    <Label Text="&#x2191;" FontSize="28" FontAttributes="Bold" TextColor="#E67E22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </dx:DXBorder>
                <Label Text="Confirmar subida de datos" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                <Label Text="Se subirán los datos al servidor y luego se descargará la información actualizada. ¿Desea continuar?"
                       FontSize="14" TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,6,0,0">
                    <Button Grid.Column="0" Text="Cancelar" Clicked="CancelarSubida_Clicked"
                            BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}"
                            CornerRadius="12" HeightRequest="46" />
                    <Button Grid.Column="1" Text="Subir" Clicked="ConfirmarSubida_Clicked"
                            BackgroundColor="#E67E22" TextColor="White" FontAttributes="Bold"
                            CornerRadius="12" HeightRequest="46" />
                </Grid>
            </dx:DXStackLayout>
        </dx:DXPopup>

        <!-- Popup de resultado (exito / error / aviso) con estilo de marca -->
        <dx:DXPopup x:Name="ResultadoPopup"
                    AllowScrim="True"
                    BackgroundColor="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    CornerRadius="20"
                    ScrimColor="#99000000"
                    IsOpen="{Binding Sync.MostrarResultado}">
            <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                             HorizontalOptions="Center" BackgroundColor="{Binding Sync.ResultadoColorSuave}">
                    <Label Text="{Binding Sync.ResultadoIcono}" FontSize="28" FontAttributes="Bold"
                           TextColor="{Binding Sync.ResultadoColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                </dx:DXBorder>
                <Label Text="{Binding Sync.ResultadoTitulo}" FontSize="18" FontAttributes="Bold"
                       TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                <Label Text="{Binding Sync.ResultadoMensaje}" FontSize="14"
                       TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                <Button Text="Aceptar" Clicked="CerrarResultado_Clicked"
                        BackgroundColor="{Binding Sync.ResultadoColor}" TextColor="White" FontAttributes="Bold"
                        CornerRadius="12" HeightRequest="46" Margin="0,6,0,0" />
            </dx:DXStackLayout>
        </dx:DXPopup>

        <!-- Overlay de espera durante la subida/descarga (Sync) -->
        <Grid IsVisible="{Binding Sync.IsBusy}" BackgroundColor="#80000000">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                <ActivityIndicator IsRunning="{Binding Sync.IsBusy}" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50" Color="White" />
                <Label Text="{Binding Sync.LoadingMessage}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="White" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</ContentPage>
