<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             ios:Page.UseSafeArea="true"
             xmlns:local="clr-namespace:v4posme_maui.ViewModels"
             x:Class="v4posme_maui.Views.LoginPage"
             BackgroundColor="{StaticResource PageBackground}">
    <ContentPage.BindingContext>
        <local:PosMeZMasterLoginViewModel />
    </ContentPage.BindingContext>

    <dxco:DXPopup x:Name="Popup"
                  IsOpen="{Binding PopupShow}"
                  AllowScrim="True"
                  BackgroundColor="{StaticResource Red}"
                  VerticalAlignment="Bottom"
                  ScrimColor="#b3adb9ce">
        <StackLayout WidthRequest="260" Padding="4">
            <Label Text="{Binding Mensaje}"
                   FontAttributes="Bold"
                   FontSize="15"
                   TextColor="{StaticResource White}"
                   Margin="20,20" />
            <Button Text="Aceptar"
                    Clicked="ClosePopup_Clicked"
                    BackgroundColor="{StaticResource Gray600}"
                    FontSize="18"
                    TextColor="White" />
        </StackLayout>
    </dxco:DXPopup>

    <Grid RowDefinitions="Auto,*">

        <!-- Encabezado con degradado y logo -->
        <Grid Grid.Row="0" HeightRequest="240">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PrimaryDark}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Primary}" Offset="1.0" />
                </LinearGradientBrush>
            </Grid.Background>
            <VerticalStackLayout VerticalOptions="Center" Spacing="10" Padding="0,10,0,40">
                <dx:DXImage Source="pm_png_192px.png"
                            HorizontalOptions="Center"
                            HeightRequest="110" />
                <Label Text="Bienvenido"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center" />
                <Label Text="Inicia sesión para continuar"
                       FontSize="13"
                       TextColor="#DCEFF7"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Tarjeta de formulario -->
        <ScrollView Grid.Row="1" Margin="0,-30,0,0">
            <dx:DXBorder Margin="18,0,18,18"
                         Padding="20,24"
                         CornerRadius="22"
                         BorderThickness="0"
                         BackgroundColor="{StaticResource White}"
                         VerticalOptions="Start">
                <dx:DXBorder.Shadow>
                    <Shadow Brush="{StaticResource Gray400Brush}" Offset="0,4" Radius="16" Opacity="0.25" />
                </dx:DXBorder.Shadow>

                <VerticalStackLayout Spacing="14">

                    <dxe:TextEdit
                        IconColor="{StaticResource Primary}"
                        StartIcon="user.svg"
                        Text="{Binding UserName}"
                        LabelText="Usuario"
                        BoxMode="Outlined" />

                    <dxe:PasswordEdit
                        IconColor="{StaticResource Primary}"
                        StartIcon="password.svg"
                        Text="{Binding Password}"
                        LabelText="Contraseña"
                        LabelFontSize="Small"
                        BoxMode="Outlined" />

                    <dxe:CheckEdit
                        HorizontalOptions="Start"
                        Padding="0"
                        IsChecked="{Binding Remember}"
                        x:Name="ChkRemember"
                        Label="Recordar usuario" />

                    <dx:DXButton
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="14"
                        HeightRequest="50"
                        Icon="login"
                        Content="Iniciar Sesión"
                        Command="{Binding LoginCommand}"
                        Margin="0,4,0,0" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" Margin="0,6" />

                    <!-- Sección de pago -->
                    <dxe:CheckEdit
                        HorizontalOptions="Start"
                        IsChecked="{Binding OpcionPagar}"
                        Padding="0"
                        Label="Realizar pago..." />

                    <dxe:ComboBoxEdit
                        IsEnabled="{Binding OpcionPagar}"
                        PickerShowMode="Popup"
                        SelectedIndex="0"
                        SelectedItem="{Binding MontoSeleccionado}"
                        BoxMode="Outlined"
                        StartIcon="money.svg">
                        <dxe:ComboBoxEdit.ItemsSource>
                            <x:Array Type="{x:Type x:Decimal}">
                                <x:Decimal>5</x:Decimal>
                                <x:Decimal>10</x:Decimal>
                                <x:Decimal>15</x:Decimal>
                                <x:Decimal>20</x:Decimal>
                                <x:Decimal>25</x:Decimal>
                                <x:Decimal>30</x:Decimal>
                            </x:Array>
                        </dxe:ComboBoxEdit.ItemsSource>
                    </dxe:ComboBoxEdit>

                    <dx:DXButton
                        IsEnabled="{Binding OpcionPagar}"
                        BackgroundColor="{StaticResource Secondary}"
                        TextColor="{StaticResource White}"
                        CornerRadius="14"
                        HeightRequest="50"
                        Icon="payment.svg"
                        Content="Realizar Pago"
                        Command="{Binding RealizarPagoCommand}" />

                    <dxe:TextEdit
                        x:Name="TxtCompany"
                        Text="{Binding Company}"
                        LabelText="Compañía"
                        BoxMode="Outlined"
                        Margin="0,6,0,0" />

                    <Label HorizontalTextAlignment="Center"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           Text="{Binding VersionApp}"
                           Margin="0,6,0,0" />
                </VerticalStackLayout>
            </dx:DXBorder>
        </ScrollView>
    </Grid>
</ContentPage>
