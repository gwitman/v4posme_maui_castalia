<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="{Binding Title}"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:viewModels="clr-namespace:v4posme_maui.ViewModels"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:core="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             ios:Page.UseSafeArea="true"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.AboutPage">
    <ContentPage.BindingContext>
        <viewModels:AboutViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <converters:PorcentajeProgresoConverter x:Key="PorcentajeProgresoConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <controls:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16,18,16,24" Spacing="16">

                    <!-- INDICADORES (ej. meta de venta) -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}"
                                   IsVisible="{Binding MostrarTarjetaIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource Secondary}" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Padding="16,14" Spacing="12">

                                <!-- Encabezado de la tarjeta -->
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <core:DXBorder Grid.Column="0"
                                                   WidthRequest="48" HeightRequest="48"
                                                   CornerRadius="12"
                                                   BorderThickness="0"
                                                   BackgroundColor="#E3F7EC"
                                                   VerticalOptions="Center">
                                        <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </core:DXBorder>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Indicadores" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="Metas y métricas del día" FontSize="11"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                <!-- Lista de indicadores -->
                                <StackLayout BindableLayout.ItemsSource="{Binding Indicadores}" Spacing="10">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Label Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource Gray600}"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding ValorFormateado}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource PrimaryDark}"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </StackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </core:DXBorder>

                    <!-- Encabezado con total consolidado -->
                    <core:DXBorder CornerRadius="20" BorderThickness="0" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PrimaryDark}" Offset="0.0" />
                                <GradientStop Color="{StaticResource Primary}" Offset="1.0" />
                            </LinearGradientBrush>
                        </core:DXBorder.Background>
                        <Grid Padding="20,18" RowSpacing="14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <VerticalStackLayout Grid.Row="0" Spacing="2">
                                <Label Text="Resumen del día"
                                       FontSize="15"
                                       TextColor="#DCEFF7"
                                       FontFamily="Roboto" />
                                <Label Text="Contado + Abonos + Ingresos − Compras − Gastos − Egreso de efectivo"
                                       FontSize="11"
                                       TextColor="#B7D8E6"
                                       FontFamily="Roboto" />
                            </VerticalStackLayout>
                            <Grid Grid.Row="1" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Total Córdobas" FontSize="12" TextColor="#DCEFF7" />
                                    <Label FontSize="22" FontAttributes="Bold" TextColor="White">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontSize="14" />
                                                <Span Text="{Binding TotalCordobas, StringFormat='{0:N2}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                                <BoxView Grid.Column="1" Color="#40FFFFFF" WidthRequest="1" VerticalOptions="Fill" />
                                <VerticalStackLayout Grid.Column="2" Spacing="2">
                                    <Label Text="Total Dólares" FontSize="12" TextColor="#DCEFF7" />
                                    <Label FontSize="22" FontAttributes="Bold" TextColor="White">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="$ " FontSize="14" />
                                                <Span Text="{Binding TotalDolares, StringFormat='{0:N2}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- FACTURAS CONTADO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource Primary}" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#E5F1F6"
                                               VerticalOptions="Center">
                                    <Image Source="invoice_bill" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Facturas de Contado" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadFacutrasContado}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="{StaticResource Primary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoFacturasContadoCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoFacturasContadoDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- FACTURAS CREDITO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource Secondary}" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#E3F7EC"
                                               VerticalOptions="Center">
                                    <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Facturas de Crédito" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadFacutrasCredito}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="{StaticResource Secondary}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoFacturasCreditoCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoFacturasCreditoDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- ABONOS -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource Magenta}" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Padding="16,14" Spacing="12">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <core:DXBorder Grid.Column="0"
                                                   WidthRequest="48" HeightRequest="48"
                                                   CornerRadius="12"
                                                   BorderThickness="0"
                                                   BackgroundColor="#FBE6F5"
                                                   VerticalOptions="Center">
                                        <Image Source="payment_2" WidthRequest="26" HeightRequest="26"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </core:DXBorder>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="Abonos Aplicados" FontSize="13" TextColor="{StaticResource Gray500}" />
                                        <Label Text="{Binding CantidadAbonos}" FontSize="26" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                                <!-- Detalle Córdobas -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Córdobas" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label Grid.Column="1" FontSize="12" TextColor="{StaticResource Gray500}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="C$ " />
                                                    <Span Text="{Binding MontoAbonosCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding MontoTotalAbonosCordobas, StringFormat='{0:N2}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                    <ProgressBar Progress="{Binding PorcentajeAbonosTotalesCordobas, Converter={StaticResource PorcentajeProgresoConverter}}"
                                                 ProgressColor="{StaticResource Primary}"
                                                 HeightRequest="6" />
                                    <Label Text="{Binding PorcentajeAbonosTotalesCordobas, StringFormat='Cumplimiento {0:F2}%'}"
                                           FontSize="11" TextColor="{StaticResource Gray400}" HorizontalOptions="End" />
                                </VerticalStackLayout>

                                <!-- Detalle Dólares -->
                                <VerticalStackLayout Spacing="4">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="Dólares" FontSize="13" FontAttributes="Bold"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label Grid.Column="1" FontSize="12" TextColor="{StaticResource Gray500}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="$ " />
                                                    <Span Text="{Binding MontoAbonosDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding MontoTotalAbonosDolares, StringFormat='{0:N2}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                    <ProgressBar Progress="{Binding PorcentajeAbonosTotalesDolares, Converter={StaticResource PorcentajeProgresoConverter}}"
                                                 ProgressColor="{StaticResource Secondary}"
                                                 HeightRequest="6" />
                                    <Label Text="{Binding PorcentajeAbonosTotalesDolares, StringFormat='Cumplimiento {0:F2}%'}"
                                           FontSize="11" TextColor="{StaticResource Gray400}" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </core:DXBorder>

                    <!-- GASTOS -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#C62828" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#FDECEE"
                                               VerticalOptions="Center">
                                    <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Gastos" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadGastos}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#C62828">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoGastosCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoGastosDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- COMPRAS / ENTRADAS DE INVENTARIO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#EF6C00" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#FDF0E3"
                                               VerticalOptions="Center">
                                    <Image Source="package_item" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Compras (Entradas de inventario)" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadEntradasInventario}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#EF6C00">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoEntradasInventarioCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoEntradasInventarioDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- SALIDAS DE INVENTARIO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#6A1B9A" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#F3E7F8"
                                               VerticalOptions="Center">
                                    <Image Source="package_item" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Salidas de inventario" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadSalidasInventario}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#6A1B9A">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoSalidasInventarioCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoSalidasInventarioDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- OTRAS ENTRADAS DE INVENTARIO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#00838F" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#E0F3F5"
                                               VerticalOptions="Center">
                                    <Image Source="package_item" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Otras entradas de inventario" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadOtraEntradaInventario}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#00838F">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoOtraEntradaInventarioCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoOtraEntradaInventarioDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- AJUSTE DE INVENTARIO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#5D4037" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#EFE7E3"
                                               VerticalOptions="Center">
                                    <Image Source="package_item" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Ajuste de inventario" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadAjusteInventario}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#5D4037">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoAjusteInventarioCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoAjusteInventarioDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- INGRESOS -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#2E7D32" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#E6F5ED"
                                               VerticalOptions="Center">
                                    <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Ingreso de efectivo" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadIngresos}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#2E7D32">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoIngresosCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoIngresosDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- SALIDA DE EFECTIVO -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="#C62828" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#FDECEE"
                                               VerticalOptions="Center">
                                    <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Salida de efectivo" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Text="{Binding CantidadEgresos}" FontSize="26" FontAttributes="Bold"
                                           TextColor="{StaticResource PrimaryDark}" />
                                    <Label Margin="0,4,0,0" FontSize="12" TextColor="#C62828">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoEgresosCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding MontoEgresosDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- INGRESO GENERAL -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}" IsVisible="{Binding MostrarIndicadores}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource PrimaryDark}" VerticalOptions="Fill" />
                            <Grid Grid.Column="1" Padding="16,14" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <core:DXBorder Grid.Column="0"
                                               WidthRequest="48" HeightRequest="48"
                                               CornerRadius="12"
                                               BorderThickness="0"
                                               BackgroundColor="#E5F1F6"
                                               VerticalOptions="Center">
                                    <Image Source="cash_pay" WidthRequest="26" HeightRequest="26"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </core:DXBorder>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Ingreso General" FontSize="13" TextColor="{StaticResource Gray500}" />
                                    <Label Margin="0,4,0,0" FontSize="14" TextColor="{StaticResource PrimaryDark}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="C$ " FontAttributes="Bold" />
                                                <Span Text="{Binding IngresoGeneralCordobas, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                                <Span Text="   ·   $ " FontAttributes="Bold" />
                                                <Span Text="{Binding IngresoGeneralDolares, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="Facturas contado + abonos + ingresos" FontSize="11"
                                           TextColor="{StaticResource Gray400}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </core:DXBorder>

                    <!-- CAMBIO DE COMPAÑIA (parametro APP_MOBILE_SWITCH_COMPANY) -->
                    <core:DXBorder CornerRadius="16" BorderThickness="0" BackgroundColor="{StaticResource White}"
                                   IsVisible="{Binding MostrarComboCompanias}">
                        <core:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray300Brush}" Offset="0,2" Radius="8" Opacity="0.3" />
                        </core:DXBorder.Shadow>
                        <Grid ColumnSpacing="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <BoxView Grid.Column="0" Color="{StaticResource PrimaryDark}" VerticalOptions="Fill" />
                            <VerticalStackLayout Grid.Column="1" Padding="16,16" Spacing="14">

                                <!-- Encabezado de la tarjeta -->
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <core:DXBorder Grid.Column="0"
                                                   WidthRequest="48" HeightRequest="48"
                                                   CornerRadius="12"
                                                   BorderThickness="0"
                                                   BackgroundColor="#E5F1F6"
                                                   VerticalOptions="Center">
                                        <Image Source="basic_home.svg" WidthRequest="26" HeightRequest="26"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </core:DXBorder>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label Text="Compañía activa" FontSize="15" FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="Selecciona para cambiar y sincronizar los datos."
                                               FontSize="11" TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Selector de compañía -->
                                <dxe:ComboBoxEdit
                                    x:Name="ComboCompanias"
                                    PickerShowMode="Popup"
                                    BoxMode="Outlined"
                                    LabelText="Compañía"
                                    LabelColor="{StaticResource Primary}"
                                    BorderColor="{StaticResource Gray300}"
                                    FocusedBorderColor="{StaticResource Primary}"
                                    CornerRadius="12"
                                    IsEnabled="{Binding ComboCompaniasHabilitado}"
                                    ItemsSource="{Binding CompaniasDisponibles}"
                                    SelectedItem="{Binding CompaniaSeleccionada}"
                                    SelectionChanged="ComboCompanias_SelectionChanged" />

                                <!-- Nota informativa -->
                                <Grid ColumnSpacing="8" IsVisible="{Binding ComboCompaniasHabilitado}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="ⓘ" FontSize="12" TextColor="{StaticResource Primary}"
                                           VerticalOptions="Start" />
                                    <Label Grid.Column="1"
                                           Text="Al cambiar de compañía se descargará nuevamente toda la información."
                                           FontSize="11" TextColor="{StaticResource Gray400}" />
                                </Grid>

                                <!-- Aviso cuando el combo esta bloqueado por transacciones pendientes -->
                                <core:DXBorder CornerRadius="10" BorderThickness="0" BackgroundColor="#FDF4E3"
                                               IsVisible="{Binding ComboCompaniasBloqueado}">
                                    <Grid Padding="12,10" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="⚠" FontSize="14" TextColor="#EF6C00"
                                               VerticalOptions="Start" />
                                        <Label Grid.Column="1"
                                               Text="Tiene transacciones pendientes por subir. Suba la información antes de cambiar de compañía."
                                               FontSize="11" TextColor="#8A5A00" />
                                    </Grid>
                                </core:DXBorder>
                            </VerticalStackLayout>
                        </Grid>
                    </core:DXBorder>

                </VerticalStackLayout>
            </ScrollView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>
