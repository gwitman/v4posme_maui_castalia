<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inventario="clr-namespace:v4posme_maui.ViewModels.Inventario"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.Inventario.SeleccionarProductoSalidaPage">
    <ContentPage.BindingContext>
        <inventario:SeleccionarProductoSalidaViewModel />
    </ContentPage.BindingContext>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="ic_arrow_back" Command="{Binding AtrasCommand}" />
    </Shell.BackButtonBehavior>
    <ContentPage.ToolbarItems>
        <ToolbarItem Order="Secondary" Text="Limpiar seleccionados"
                     Command="{Binding LimpiarSeleccionadosCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <converters:ToLowerConverter x:Key="ToLowerConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <dxc:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <dxc:ShimmerView.Content>
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Barra de busqueda -->
                    <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8" BackgroundColor="{StaticResource White}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <dxe:TextEdit Grid.Column="0" Style="{StaticResource SearchEditorStyle}"
                                      PlaceholderText="Buscar producto..." Text="{Binding Search}" />
                        <dx:DXButton Grid.Column="1" Style="{StaticResource SinFondoColorRedondeado}"
                                     IconHeight="24" IconWidth="24" Command="{Binding SearchCommand}" Icon="search" />
                        <dx:DXButton Grid.Column="2" Style="{StaticResource SinFondoColorRedondeado}"
                                     IconHeight="24" IconWidth="24" Command="{Binding SearchBarCodeCommand}" Icon="barcode_scaner" />
                    </Grid>

                    <!-- Lista de todos los productos con editor de cantidad en linea -->
                    <dxcv:DXCollectionView Grid.Row="1" x:Name="ProductosCollectionView"
                                           ItemSeparatorThickness="0"
                                           ItemsSource="{Binding Productos}">
                        <dxcv:DXCollectionView.ItemTemplate>
                            <DataTemplate>
                                <dx:DXBorder Margin="10,5" Padding="10" CornerRadius="12"
                                             BorderThickness="0" BackgroundColor="{StaticResource White}">
                                    <dx:DXBorder.Shadow>
                                        <Shadow Brush="{StaticResource Gray300}" Offset="0,1" Radius="4" Opacity="0.25" />
                                    </dx:DXBorder.Shadow>
                                    <StackLayout Spacing="6">
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <StackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                <Label Text="{Binding Name, Converter={StaticResource ToLowerConverter}}"
                                                       FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray900}"
                                                       LineBreakMode="TailTruncation" MaxLines="1" />
                                                <Label Text="{Binding ItemNumber}" FontSize="11" TextColor="{StaticResource Gray400}" />
                                            </StackLayout>
                                            <dxe:TextEdit Grid.Column="1" Keyboard="Numeric" LabelText="Cantidad"
                                                          TextChanged="OnValorChanged" Text="{Binding Quantity}" />
                                        </Grid>
                                        <!-- Solo visualizacion: costo unitario y subtotal (costo x cantidad). -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label Grid.Column="0" FontSize="11" TextColor="{StaticResource Gray400}"
                                                   VerticalOptions="Center"
                                                   Text="{Binding Cost, StringFormat='Costo: C$ {0:N2} c/u'}" />
                                            <Label Grid.Column="1" FontSize="13" FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" VerticalOptions="Center"
                                                   Text="{Binding Importe, StringFormat='C$ {0:N2}'}" />
                                        </Grid>
                                    </StackLayout>
                                </dx:DXBorder>
                            </DataTemplate>
                        </dxcv:DXCollectionView.ItemTemplate>
                    </dxcv:DXCollectionView>

                    <!-- Panel inferior: resumen y continuar -->
                    <dx:DXBorder Grid.Row="2" BackgroundColor="{StaticResource White}"
                                 CornerRadius="18,18,0,0" BorderThickness="0" Padding="16,12">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray400}" Offset="0,-2" Radius="8" Opacity="0.15" />
                        </dx:DXBorder.Shadow>
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="46" />
                            </Grid.RowDefinitions>
                            <dx:DXBorder Grid.Row="0" Padding="12,8" CornerRadius="10"
                                         BackgroundColor="{StaticResource PageBackground}" BorderThickness="0">
                                <Label Text="{Binding ProductosSeleccionadosCantidadTotal}" FontSize="14"
                                       FontAttributes="Bold" TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center" />
                            </dx:DXBorder>
                            <dx:DXButton Grid.Row="1" CornerRadius="12"
                                         Command="{Binding ProductosSeleccionadosCommand}"
                                         Content="{Binding ProductosSeleccionadosCantidad}" />
                        </Grid>
                    </dx:DXBorder>
                </Grid>
            </dxc:ShimmerView.Content>
            <dxc:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="50" WidthRequest="50" />
            </dxc:ShimmerView.LoadingView>
        </dxc:ShimmerView>
    </ContentPage.Content>
</ContentPage>
