<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inventario="clr-namespace:v4posme_maui.ViewModels.Inventario"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.Inventario.VisualizarEntradaPage">
    <ContentPage.BindingContext>
        <inventario:VisualizarEntradaViewModel />
    </ContentPage.BindingContext>
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="{Binding AbiertoDesdeImpresiones}"
                            IsEnabled="{Binding AbiertoDesdeImpresiones}"
                            Command="{Binding RegresarCommand}" />
    </Shell.BackButtonBehavior>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="shared" Clicked="Compartir_OnClicked" />
        <ToolbarItem Text="Nueva compra" Order="Secondary" Command="{Binding NuevaCommand}" />
        <ToolbarItem Text="Imprimir" Order="Secondary" Command="{Binding ImprimirCommand}" />
        <ToolbarItem Text="Eliminar" Order="Secondary" Command="{Binding EliminarCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <converters:ToLowerConverter x:Key="ToLowerConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <dxc:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <dxc:ShimmerView.Content>
              <Grid>
                <Grid x:Name="ShareLayout" RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource White}">

                    <!-- Encabezado compacto -->
                    <StackLayout Grid.Row="0" Spacing="2" Padding="16,10,16,8" BackgroundColor="{StaticResource White}">
                        <dx:DXImage Source="{Binding LogoSource}"
                                    HeightRequest="200" WidthRequest="200"
                                    Aspect="AspectFit"
                                    HorizontalOptions="Center" />
                        <Label Text="{Binding CompanyName}" FontAttributes="Bold" FontSize="15"
                               TextColor="{StaticResource Gray900}" HorizontalTextAlignment="Center" Margin="0,2,0,0" />
                        <dx:DXBorder HorizontalOptions="Center" Padding="12,2" CornerRadius="10" BorderThickness="0"
                                     BackgroundColor="{StaticResource Primary}" Margin="0,2">
                            <Label Text="COMPRA" FontAttributes="Bold" FontSize="12" TextColor="White" />
                        </dx:DXBorder>
                        <Label Text="{Binding Codigo}" FontAttributes="Bold" FontSize="13"
                               TextColor="{StaticResource PrimaryDark}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding FechaTexto}" FontSize="11"
                               TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                    </StackLayout>

                    <!-- Cuerpo -->
                    <dxcv:DXCollectionView Grid.Row="1" ItemSeparatorThickness="0.5"
                                           ItemSeparatorColor="{StaticResource SeparatorColor}"
                                           ItemsSource="{Binding Items}">
                        <dxcv:DXCollectionView.HeaderTemplate>
                            <DataTemplate>
                                <StackLayout Spacing="0">
                                    <dx:DXBorder Margin="12,8,12,4" Padding="10,6" CornerRadius="8" BorderThickness="0"
                                                 BackgroundColor="{StaticResource PageBackground}">
                                        <Label Text="{Binding Comentarios}" FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                    </dx:DXBorder>
                                    <Grid Padding="14,4,14,4" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0" Text="CANT" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                                        <Label Grid.Column="1" Text="PRODUCTO" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                                        <Label Grid.Column="2" Text="IMPORTE" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource Gray400}" />
                                    </Grid>
                                </StackLayout>
                            </DataTemplate>
                        </dxcv:DXCollectionView.HeaderTemplate>
                        <dxcv:DXCollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="14,8" ColumnSpacing="8" BackgroundColor="{StaticResource White}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <dx:DXBorder Grid.Column="0" WidthRequest="34" HeightRequest="26" CornerRadius="6"
                                                 BackgroundColor="{StaticResource PageBackground}" BorderThickness="0"
                                                 HorizontalOptions="Start" VerticalOptions="Center">
                                        <Label Text="{Binding Quantity, StringFormat='{0:0.##}'}" FontAttributes="Bold" FontSize="12"
                                               TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </dx:DXBorder>
                                    <StackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name, Converter={StaticResource ToLowerConverter}}"
                                               FontSize="13" TextColor="{StaticResource Gray900}"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Cost, StringFormat='C$ {0:N2} c/u'}"
                                               FontSize="11" TextColor="{StaticResource Gray400}" />
                                    </StackLayout>
                                    <Label Grid.Column="2" VerticalOptions="Center" FontAttributes="Bold" FontSize="13"
                                           TextColor="{StaticResource PrimaryDark}"
                                           Text="{Binding Importe, StringFormat='C$ {0:N2}'}" />
                                </Grid>
                            </DataTemplate>
                        </dxcv:DXCollectionView.ItemTemplate>
                    </dxcv:DXCollectionView>

                    <!-- Pie de pagina compacto -->
                    <dx:DXBorder Grid.Row="2" BackgroundColor="{StaticResource White}"
                                 CornerRadius="18,18,0,0" BorderThickness="0" Padding="16,10">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray400}" Offset="0,-2" Radius="8" Opacity="0.15" />
                        </dx:DXBorder.Shadow>
                        <StackLayout Spacing="4">
                            <dx:DXBorder Padding="12,8" CornerRadius="10" BorderThickness="0"
                                         BackgroundColor="{StaticResource Primary}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Text="TOTAL" FontSize="14" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center" />
                                    <Label Grid.Column="1" FontSize="17" FontAttributes="Bold"
                                           TextColor="White" VerticalOptions="Center"
                                           Text="{Binding Total, StringFormat='C$ {0}'}" />
                                </Grid>
                            </dx:DXBorder>
                            <Label Text="{Binding CompanyAddress}" FontSize="11"
                                   TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" Margin="0,2,0,0" />
                            <Label Text="{Binding CompanyTelefono}" FontSize="11"
                                   TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center" />
                            <Button Text="Subir Datos"
                                    Command="{Binding Sync.MostrarConfirmacionSubidaCommand}"
                                    BackgroundColor="#E67E22"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="48"
                                    Margin="0,10,0,0" />
                        </StackLayout>
                    </dx:DXBorder>
                </Grid>

                <!-- Popup de confirmacion de subida (estilo de marca posMe) -->
                <dxc:DXPopup x:Name="ConfirmarSubidaPopup"
                             AllowScrim="True"
                             BackgroundColor="White"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             CornerRadius="20"
                             ScrimColor="#99000000"
                             IsOpen="{Binding Sync.MostrarConfirmacionSubida}">
                    <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                                     HorizontalOptions="Center" BackgroundColor="#FDF0E3">
                            <Label Text="&#x2191;" FontSize="28" FontAttributes="Bold" TextColor="#E67E22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="Confirmar subida de datos" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="Se subirán los datos al servidor y luego se descargará la información actualizada. ¿Desea continuar?"
                               FontSize="14" TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Text="Cancelar" Clicked="CancelarSubida_Clicked"
                                    BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}"
                                    CornerRadius="12" HeightRequest="46" />
                            <Button Grid.Column="1" Text="Subir" Clicked="ConfirmarSubida_Clicked"
                                    BackgroundColor="#E67E22" TextColor="White" FontAttributes="Bold"
                                    CornerRadius="12" HeightRequest="46" />
                        </Grid>
                    </dx:DXStackLayout>
                </dxc:DXPopup>

                <!-- Popup de resultado (exito / error / aviso) con estilo de marca -->
                <dxc:DXPopup x:Name="ResultadoPopup"
                             AllowScrim="True"
                             BackgroundColor="White"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             CornerRadius="20"
                             ScrimColor="#99000000"
                             IsOpen="{Binding Sync.MostrarResultado}">
                    <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                                     HorizontalOptions="Center" BackgroundColor="{Binding Sync.ResultadoColorSuave}">
                            <Label Text="{Binding Sync.ResultadoIcono}" FontSize="28" FontAttributes="Bold"
                                   TextColor="{Binding Sync.ResultadoColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="{Binding Sync.ResultadoTitulo}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Sync.ResultadoMensaje}" FontSize="14"
                               TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                        <Button Text="Aceptar" Clicked="CerrarResultado_Clicked"
                                BackgroundColor="{Binding Sync.ResultadoColor}" TextColor="White" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="46" Margin="0,6,0,0" />
                    </dx:DXStackLayout>
                </dxc:DXPopup>

                <!-- Overlay de espera durante la subida/descarga (Sync) -->
                <Grid IsVisible="{Binding Sync.IsBusy}" BackgroundColor="#80000000">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding Sync.IsBusy}" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50" Color="White" />
                        <Label Text="{Binding Sync.LoadingMessage}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
              </Grid>
            </dxc:ShimmerView.Content>
            <dxc:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="50" WidthRequest="50" />
            </dxc:ShimmerView.LoadingView>
        </dxc:ShimmerView>
    </ContentPage.Content>
</ContentPage>
