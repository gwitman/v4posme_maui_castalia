<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:inventario="clr-namespace:v4posme_maui.ViewModels.Inventario"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.Inventario.DatosSalidaPage">
    <ContentPage.BindingContext>
        <inventario:DatosSalidaViewModel />
    </ContentPage.BindingContext>
    <!-- Pagina raiz del flyout: se muestra el icono de menu (hamburguesa) nativo del Shell.
         Se fuerza FlyoutBehavior=Flyout para garantizar que el icono siempre aparezca. -->
    <Shell.FlyoutBehavior>Flyout</Shell.FlyoutBehavior>
    <ContentPage.Content>
        <controls:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <ScrollView>
                    <StackLayout Padding="0,0,0,20">
                        <dx:DXBorder Margin="14,16,14,14"
                                     BackgroundColor="{StaticResource White}"
                                     BorderThickness="0" CornerRadius="16">
                            <Grid RowSpacing="15" Padding="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <dxe:TextEdit
                                    Grid.Row="0"
                                    IconColor="{StaticResource Primary}"
                                    HasError="{Binding ErrorComentarios}"
                                    IsErrorIconVisible="{Binding ErrorComentarios}"
                                    StartIcon="identificacion"
                                    Text="{Binding Comentarios}"
                                    LabelText="Comentario" />
                                <dxe:TextEdit
                                    Grid.Row="1"
                                    IconColor="{StaticResource Primary}"
                                    StartIcon="identificacion"
                                    Text="{Binding Referencia1}"
                                    LabelText="Referencia 1" />
                                <dxe:TextEdit
                                    Grid.Row="2"
                                    IconColor="{StaticResource Primary}"
                                    StartIcon="identificacion"
                                    Text="{Binding Referencia2}"
                                    LabelText="Referencia 2" />
                                <dx:DXButton
                                    Grid.Row="3"
                                    Content="Siguiente"
                                    CornerRadius="12"
                                    Command="{Binding SiguienteCommand}" />
                            </Grid>
                        </dx:DXBorder>
                    </StackLayout>
                </ScrollView>
            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}" HeightRequest="50" WidthRequest="50" />
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>
