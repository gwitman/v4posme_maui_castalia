<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:abonos="clr-namespace:v4posme_maui.ViewModels.Abonos"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             Title="{Binding Title}"
             x:Class="v4posme_maui.Views.Abonos.ValidarAbonoPage"
             Style="{StaticResource DetailPageStyle}">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False" IsVisible="False" />
    </Shell.BackButtonBehavior>
    <Shell.PresentationMode>Animated</Shell.PresentationMode>
    <ContentPage.BindingContext>
        <abonos:ValidarAbonoViewModel />
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="shared" Clicked="MenuItem_OnClicked" />
        <ToolbarItem Text="Imprimir" Order="Secondary" x:Name="ItemPrint" Command="{Binding PrintCommand}" />
        <ToolbarItem Text="Nuevo Abono" Order="Secondary" Command="{Binding AplicarOtroCommand}" />
        <ToolbarItem Text="Anular Abono" Order="Secondary" x:Name="ItemAnular" Command="{Binding AnularCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <controls:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
              <Grid>
                <ScrollView>
                    <dx:DXStackLayout
                        BackgroundColor="White"
                        x:Name="DxStackLayout"
                        Orientation="Vertical"
                        Padding="20">
                        <controls:DXPopup x:Name="Popup"
                                          AllowScrim="True"
                                          BackgroundColor="{Binding PopupBackgroundColor}"
                                          VerticalAlignment="Bottom"
                                          HorizontalAlignment="Stretch"
                                          Margin="16"
                                          CornerRadius="16"
                                          ScrimColor="#b3adb9ce"
                                          IsOpen="{Binding PopUpShow}">
                            <StackLayout WidthRequest="250" Padding="4">
                                <Label Text="{Binding Mensaje}"
                                       FontAttributes="Bold"
                                       FontSize="15"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{StaticResource White}"
                                       Margin="20, 20" />
                                <Button Text="Aceptar"
                                        Clicked="ClosePopup_Clicked"
                                        BackgroundColor="{StaticResource Gray600}"
                                        CornerRadius="12"
                                        HeightRequest="46"
                                        FontSize="18"
                                        TextColor="White" />
                            </StackLayout>
                        </controls:DXPopup>
                        <dx:DXStackLayout Orientation="Vertical"
                                          Margin="0,0,0,10"
                                          HorizontalOptions="Center">
                            <dx:DXImage x:Name="Logo"
                                        HeightRequest="150"
                                        WidthRequest="150"
                                        Source="{Binding LogoSource}" />
                            <Label Text="Comprobante de Abono"
                                   FontSize="24"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold" />
                            <dx:DXBorder HeightRequest="3"
                                         WidthRequest="60"
                                         CornerRadius="2"
                                         BorderThickness="0"
                                         Margin="0,6,0,10"
                                         HorizontalOptions="Center"
                                         BackgroundColor="{StaticResource Secondary}" />
                            <Label FontSize="16"
                                   HorizontalTextAlignment="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Le informamos que: " />
                                        <Span Text="{Binding Item.FirstName}" FontAttributes="Bold" />
                                        <Span Text=" " />
                                        <Span Text="{Binding Item.LastName}" FontAttributes="Bold" />
                                        <Span Text=" creó un código para abono de factura con los siguientes datos" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </dx:DXStackLayout>
                        <dx:DXStackLayout Orientation="Horizontal">
                            <Label Text="Código de abono: " FontAttributes="Bold" FontSize="14" />
                            <Label Text="{Binding Item.CodigoAbono}"
                                   TextColor="{StaticResource Primary}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                        </dx:DXStackLayout>
                        <StackLayout Spacing="5">
                            <dx:DXStackLayout Orientation="Horizontal">
                                <Label Text="Nombres: " FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding Item.FirstName}" FontSize="14" />
                            </dx:DXStackLayout>
                            <dx:DXStackLayout Orientation="Horizontal">
                                <Label Text="Apellidos: " FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding Item.LastName}" FontSize="14" />
                            </dx:DXStackLayout>
                            <dx:DXBorder
                                Margin="0,6"
                                Padding="16"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderColor="{StaticResource SeparatorColor}"
                                BackgroundColor="#FAFAFA">
                            <Grid
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Text="Fecha:" 
                                    FontAttributes="Bold" FontSize="14" />
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Text="{Binding Item.Fecha, StringFormat='{0:yyyy-MM-dd}'}"
                                       FontSize="14" />
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="Saldo Inicial: " FontAttributes="Bold" 
                                    FontSize="14" />
                                <dx:DXStackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Label Text="{Binding Item.CurrencyName}" FontSize="14" />
                                    <Label Text=" " />
                                    <Label Text="{Binding Item.SaldoInicial, StringFormat='{0:N2}'}"
                                           FontSize="14" />
                                </dx:DXStackLayout>
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Text="Monto Aplicar: " 
                                    FontAttributes="Bold" 
                                    FontSize="14" />
                                <dx:DXStackLayout
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Label Text="{Binding Item.CurrencyName}" FontSize="14" />
                                    <Label Text=" " />
                                    <Label Text="{Binding Item.MontoAplicar, StringFormat='{0:N2}'}"
                                           FontSize="14" />
                                </dx:DXStackLayout>
                                <Label
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Text="Saldo final: " 
                                       FontAttributes="Bold" FontSize="14" />
                                <dx:DXStackLayout
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Orientation="Horizontal">
                                    <Label Text="{Binding Item.CurrencyName}" FontSize="14" />
                                    <Label Text=" " />
                                    <Label Text="{Binding Item.SaldoFinal, StringFormat='{0:N0}'}"
                                           FontSize="14" />
                                </dx:DXStackLayout>
                            </Grid>
                            </dx:DXBorder>
                            <dx:DXStackLayout Orientation="Vertical">
                                <Label Text="Comentarios: " FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding Item.Description}" FontSize="14" />
                            </dx:DXStackLayout>
                        </StackLayout>

                        <Button Text="Subir Datos"
                                Command="{Binding Sync.MostrarConfirmacionSubidaCommand}"
                                BackgroundColor="#E67E22"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                Margin="0,20,0,10" />
                    </dx:DXStackLayout>
                </ScrollView>

                <!-- Popup de confirmacion de subida (estilo de marca posMe) -->
                <controls:DXPopup x:Name="ConfirmarSubidaPopup"
                                  AllowScrim="True"
                                  BackgroundColor="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  CornerRadius="20"
                                  ScrimColor="#99000000"
                                  IsOpen="{Binding Sync.MostrarConfirmacionSubida}">
                    <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                                     HorizontalOptions="Center" BackgroundColor="#FDF0E3">
                            <Label Text="&#x2191;" FontSize="28" FontAttributes="Bold" TextColor="#E67E22"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="Confirmar subida de datos" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="Se subirán los datos al servidor y luego se descargará la información actualizada. ¿Desea continuar?"
                               FontSize="14" TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                        <Grid ColumnSpacing="12" Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Text="Cancelar" Clicked="CancelarSubida_Clicked"
                                    BackgroundColor="{StaticResource Gray200}" TextColor="{StaticResource Gray900}"
                                    CornerRadius="12" HeightRequest="46" />
                            <Button Grid.Column="1" Text="Subir" Clicked="ConfirmarSubida_Clicked"
                                    BackgroundColor="#E67E22" TextColor="White" FontAttributes="Bold"
                                    CornerRadius="12" HeightRequest="46" />
                        </Grid>
                    </dx:DXStackLayout>
                </controls:DXPopup>

                <!-- Popup de resultado (exito / error / aviso) con estilo de marca -->
                <controls:DXPopup x:Name="ResultadoPopup"
                                  AllowScrim="True"
                                  BackgroundColor="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  CornerRadius="20"
                                  ScrimColor="#99000000"
                                  IsOpen="{Binding Sync.MostrarResultado}">
                    <dx:DXStackLayout WidthRequest="300" Padding="24" ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56" WidthRequest="56" CornerRadius="28"
                                     HorizontalOptions="Center" BackgroundColor="{Binding Sync.ResultadoColorSuave}">
                            <Label Text="{Binding Sync.ResultadoIcono}" FontSize="28" FontAttributes="Bold"
                                   TextColor="{Binding Sync.ResultadoColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="{Binding Sync.ResultadoTitulo}" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding Sync.ResultadoMensaje}" FontSize="14"
                               TextColor="{StaticResource Gray600}" HorizontalTextAlignment="Center" />
                        <Button Text="Aceptar" Clicked="CerrarResultado_Clicked"
                                BackgroundColor="{Binding Sync.ResultadoColor}" TextColor="White" FontAttributes="Bold"
                                CornerRadius="12" HeightRequest="46" Margin="0,6,0,0" />
                    </dx:DXStackLayout>
                </controls:DXPopup>

                <!-- Overlay de espera durante la subida/descarga (Sync) -->
                <Grid IsVisible="{Binding Sync.IsBusy}" BackgroundColor="#80000000">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12">
                        <ActivityIndicator IsRunning="{Binding Sync.IsBusy}" HorizontalOptions="Center" HeightRequest="50" WidthRequest="50" Color="White" />
                        <Label Text="{Binding Sync.LoadingMessage}" HorizontalTextAlignment="Center" FontAttributes="Bold" TextColor="White" />
                    </VerticalStackLayout>
                </Grid>
              </Grid>
            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>