<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:viewModels="clr-namespace:v4posme_maui.ViewModels"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             x:Class="v4posme_maui.Views.ParameterPage">
    <ContentPage.BindingContext>
        <viewModels:PosMeParameterViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary Source="../Resources/Styles/Colors.xaml" />
        <ResourceDictionary Source="../Resources/Styles/Styles.xaml" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding SaveCommand}" Text="Save"
                     IconImageSource="{AppThemeBinding Light=save, Dark=save}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Refreshing="RefreshView_OnRefreshing"
                     RefreshColor="{StaticResource Primary}"
                     Command="{Binding RefreshCommand}">
            <ScrollView>
                <dx:DXStackLayout Orientation="Vertical"
                                  Padding="0,0,0,24">
                    <dxco:DXPopup x:Name="Popup"
                                  AllowScrim="True"
                                  BackgroundColor="{Binding PopupBackgroundColor}"
                                  VerticalAlignment="Bottom"
                                  HorizontalAlignment="Stretch"
                                  Margin="16"
                                  CornerRadius="16"
                                  ScrimColor="#b3adb9ce"
                                  IsOpen="{Binding PopUpShow}">
                        <StackLayout WidthRequest="250" Padding="4">
                            <Label Text="{Binding Mensaje}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource White}"
                                   Margin="20, 20" />
                            <Button Text="Aceptar"
                                    Clicked="ClosePopup_Clicked"
                                    BackgroundColor="{StaticResource Gray600}"
                                    CornerRadius="12"
                                    HeightRequest="46"
                                    FontSize="18"
                                    TextColor="White" />
                        </StackLayout>
                    </dxco:DXPopup>

                    <!-- Encabezado -->
                    <dx:DXBorder BackgroundColor="{StaticResource Primary}"
                                 CornerRadius="0,0,28,28"
                                 BorderThickness="0"
                                 Padding="0,20,0,26">
                        <dx:DXStackLayout Orientation="Vertical" HorizontalOptions="Center">
                            <dx:DXBorder WidthRequest="96"
                                         HeightRequest="96"
                                         CornerRadius="48"
                                         BorderThickness="0"
                                         HorizontalOptions="Center"
                                         BackgroundColor="#33FFFFFF">
                                <Image Source="settings"
                                       WidthRequest="52"
                                       HeightRequest="52"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Aspect="AspectFit" />
                            </dx:DXBorder>
                            <Label Text="Parámetros del sistema"
                                   FontSize="18"
                                   TextColor="White"
                                   Margin="0,12,0,0"
                                   HorizontalTextAlignment="Center"
                                   FontAttributes="Bold" />
                        </dx:DXStackLayout>
                    </dx:DXBorder>

                    <!-- Tarjeta de parametros -->
                    <dx:DXBorder
                        Margin="14,16,14,14"
                        Padding="6,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}"
                        BorderThickness="0" CornerRadius="16">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="14" Offset="0,4" />
                        </dx:DXBorder.Shadow>
                        <dx:DXStackLayout Orientation="Vertical" ItemSpacing="4" Padding="8">
                            <dxe:NumericEdit
                                x:Name="TextContador"
                                MinValue="0"
                                LabelColor="{StaticResource Primary}"
                                IsUpDownIconVisible="True"
                                TextHorizontalAlignment="Start"
                                IconColor="{StaticResource Primary}"
                                StartIcon="quantity"
                                Value="{Binding Contador}"
                                LabelText="Contador de Transacciones" />
                            <dxe:TextEdit
                                x:Name="TextPrinter"
                                HasError="{Binding PrinterHasError}"
                                ErrorText="Debe especificar un Nombre de impresora..."
                                IsErrorIconVisible="True"
                                IconColor="#006E98"
                                StartIcon="textbox"
                                Text="{Binding Printer}"
                                LabelText="Nombre de impresora" />
                            <dxe:TextEdit
                                x:Name="TextCodigoAbono"
                                HasError="{Binding AbonoHasError}"
                                ErrorText="Debe especificar un código de abono..."
                                IsErrorIconVisible="True"
                                IconColor="#006E98"
                                StartIcon="textbox"
                                Text="{Binding CodigoAbono}"
                                LabelText="Código de Abono" />
                            <dxe:TextEdit
                                x:Name="TextCodigoFactura"
                                HasError="{Binding FacturaHasError}"
                                ErrorText="Debe especificar un código de factura..."
                                IsErrorIconVisible="True"
                                IconColor="#006E98"
                                StartIcon="textbox"
                                Text="{Binding CodigoFactura}"
                                LabelText="Código de Factura" />
                        </dx:DXStackLayout>
                    </dx:DXBorder>

                    <!-- Tarjeta de logo -->
                    <dx:DXBorder
                        Margin="14,0,14,14"
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}"
                        BorderThickness="0" CornerRadius="16">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="14" Offset="0,4" />
                        </dx:DXBorder.Shadow>
                        <dx:DXStackLayout Orientation="Vertical" HorizontalOptions="Center">
                            <Label TextColor="{StaticResource Primary}"
                                   Text="Seleccionar logo"
                                   FontAttributes="Bold"
                                   Margin="0,0,0,10"
                                   HorizontalOptions="Center" />
                            <Grid HeightRequest="150" WidthRequest="150">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ImageTapped" />
                                </Grid.GestureRecognizers>
                                <dx:DXBorder CornerRadius="14"
                                             BorderThickness="1"
                                             BorderColor="{StaticResource SeparatorColor}"
                                             WidthRequest="150"
                                             HeightRequest="150">
                                    <dx:DXImage x:Name="Preview"
                                                Source="{Binding ShowImage}"
                                                Aspect="AspectFit" />
                                </dx:DXBorder>
                                <dx:DXBorder x:Name="EditControl" BorderColor="White" BorderThickness="2"
                                             BackgroundColor="{StaticResource Primary}"
                                             WidthRequest="48" HeightRequest="48" CornerRadius="24" HorizontalOptions="End"
                                             VerticalOptions="End">
                                    <dx:DXImage Source="pencil" WidthRequest="24" HeightRequest="24" />
                                </dx:DXBorder>
                            </Grid>
                        </dx:DXStackLayout>
                    </dx:DXBorder>

                    <dxco:BottomSheet x:Name="BottomSheet" HalfExpandedRatio="0.3" AllowedState="HalfExpanded">
                        <Grid RowDefinitions="Auto, Auto, Auto" RowSpacing="5">
                            <dx:DXButton Style="{StaticResource SinFondoColorRedondeado}"
                                         Icon="delete"
                                         Content="Eliminar logo"
                                         Tap="DeletePhotoClicked" />
                            <dx:DXButton Grid.Row="1"
                                         Style="{StaticResource SinFondoColorRedondeado}"
                                         Icon="take_photo"
                                         Content="Hacer foto"
                                         Tap="TakePhotoClicked" />
                            <dx:DXButton Grid.Row="2"
                                         Style="{StaticResource SinFondoColorRedondeado}"
                                         Icon="gallery"
                                         Content="Selecciona desde la galeria"
                                         Tap="SelectPhotoClicked" />
                        </Grid>
                    </dxco:BottomSheet>

                </dx:DXStackLayout>
            </ScrollView>
        </RefreshView>
    </ContentPage.Content>
</ContentPage>
