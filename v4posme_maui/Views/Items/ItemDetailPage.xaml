<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcn="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             Title="{Binding Title}"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             ios:Page.UseSafeArea="true"
             x:Class="v4posme_maui.Views.Items.ItemDetailPage"
             Style="{StaticResource DetailPageStyle}">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
            StatusBarStyle="{AppThemeBinding Light=DarkContent, Dark=LightContent}" />
    </ContentPage.Behaviors>
    <ContentPage.ToolbarItems>
        <ToolbarItem Command="{Binding EditCommand}" Text="Edit"
                     IconImageSource="{AppThemeBinding Light=edit, Dark=edit}" />
        <ToolbarItem Clicked="DeleteItemClick" Text="Delete"
                     IconImageSource="{AppThemeBinding Light=delete, Dark=delete}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">
    <ScrollView Grid.Row="0">
        <dx:DXStackLayout Orientation="Vertical" Padding="0,0,0,24">

            <!-- Encabezado -->
            <dx:DXBorder BackgroundColor="{StaticResource Primary}"
                         CornerRadius="0,0,32,32"
                         BorderThickness="0"
                         Padding="0,24,0,32">
                <dx:DXStackLayout Orientation="Vertical" HorizontalOptions="Center">
                    <dx:DXBorder WidthRequest="112"
                                 HeightRequest="112"
                                 CornerRadius="56"
                                 BorderThickness="0"
                                 HorizontalOptions="Center"
                                 IsClippedToBounds="True"
                                 BackgroundColor="#33FFFFFF">
                        <Image x:Name="ImgProducto"
                               Source="product_delivery.png"
                               WidthRequest="112"
                               HeightRequest="112"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Aspect="AspectFill" />
                    </dx:DXBorder>
                    <Label Text="{Binding Item.Name}"
                           FontSize="22"
                           TextColor="White"
                           Margin="24,14,24,0"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />
                    <dx:DXStackLayout Orientation="Horizontal"
                                      HorizontalOptions="Center"
                                      ItemSpacing="8"
                                      Margin="0,10,0,0">
                        <dx:DXBorder CornerRadius="12" BorderThickness="0"
                                     BackgroundColor="#26FFFFFF" Padding="12,5">
                            <Label Text="{Binding Item.BarCode, StringFormat='Código: {0}'}"
                                   TextColor="White" FontSize="13" />
                        </dx:DXBorder>
                        <dx:DXBorder CornerRadius="12" BorderThickness="0"
                                     BackgroundColor="#26FFFFFF" Padding="12,5">
                            <Label Text="{Binding Item.ItemNumber}"
                                   TextColor="White" FontSize="13" />
                        </dx:DXBorder>
                    </dx:DXStackLayout>
                </dx:DXStackLayout>
            </dx:DXBorder>

            <!-- Precio y Costo destacados -->
            <dx:DXStackLayout Orientation="Horizontal" Margin="14,18,14,6" ItemSpacing="12">
                <dx:DXBorder HorizontalOptions="FillAndExpand"
                             CornerRadius="18" BorderThickness="0" Padding="16,18"
                             BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}">
                    <dx:DXBorder.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="12" Offset="0,4" />
                    </dx:DXBorder.Shadow>
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="PRECIO AL PÚBLICO" FontSize="11" TextColor="{StaticResource Primary}" FontAttributes="Bold" />
                        <Label Text="{Binding Item.PrecioPublico, StringFormat='{0:N2}'}"
                               FontSize="22" FontAttributes="Bold" Margin="0,4,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
                <dx:DXBorder HorizontalOptions="FillAndExpand"
                             CornerRadius="18" BorderThickness="0" Padding="16,18"
                             BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}">
                    <dx:DXBorder.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="12" Offset="0,4" />
                    </dx:DXBorder.Shadow>
                    <dx:DXStackLayout Orientation="Vertical">
                        <Label Text="COSTO" FontSize="11" TextColor="#C62828" FontAttributes="Bold" />
                        <Label Text="{Binding Item.Cost, StringFormat='{0:N2}'}"
                               FontSize="22" FontAttributes="Bold" TextColor="#C62828" Margin="0,4,0,0" />
                    </dx:DXStackLayout>
                </dx:DXBorder>
            </dx:DXStackLayout>

            <!-- Tarjeta de existencias -->
            <dx:DXBorder Margin="14,10,14,6"
                         CornerRadius="18" BorderThickness="0" Padding="4,6"
                         BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}">
                <dx:DXBorder.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Opacity="0.12" Radius="12" Offset="0,4" />
                </dx:DXBorder.Shadow>
                <dx:DXStackLayout Orientation="Vertical" Padding="12,8">
                    <Label Text="Inventario" FontAttributes="Bold" TextColor="{StaticResource Primary}" FontSize="15" Margin="4,4,0,6" />

                    <dx:DXStackLayout Orientation="Horizontal" Padding="4,10">
                        <Label Text="Existencia final " FontSize="15" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding Item.CantidadFinal, StringFormat='{0:N2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </dx:DXStackLayout>
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />

                    <dx:DXStackLayout Orientation="Horizontal" Padding="4,10">
                        <Label Text="Cantidad facturadas " FontSize="15" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding Item.CantidadFacturadas, StringFormat='{0:N2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </dx:DXStackLayout>
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />

                    <dx:DXStackLayout Orientation="Horizontal" Padding="4,10">
                        <Label Text="Cantidad ingresadas " FontSize="15" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding Item.CantidadEntradas, StringFormat='{0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#2E7D32" VerticalOptions="Center" />
                    </dx:DXStackLayout>
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />

                    <dx:DXStackLayout Orientation="Horizontal" Padding="4,10">
                        <Label Text="Cantidad retirada " FontSize="15" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding Item.CantidadSalidas, StringFormat='{0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#C62828" VerticalOptions="Center" />
                    </dx:DXStackLayout>
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />

                    <dx:DXStackLayout Orientation="Horizontal" Padding="4,10">
                        <Label Text="Cantidad inicial " FontSize="15" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Label Text="{Binding Item.Quantity, StringFormat='{0:N2}'}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                    </dx:DXStackLayout>
                </dx:DXStackLayout>
            </dx:DXBorder>

            <dxcn:DXPopup x:Name="Popup" AllowScrim="True"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Stretch"
                          Margin="16" CornerRadius="16"
                          BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                <dx:DXStackLayout Orientation="Vertical" Padding="10">
                    <Label Text="¿Seguro quiere eliminar este producto? Está acción no se puede revertir"
                           Margin="0,20"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />
                    <dx:DXButton Content="Eliminar"
                                 Icon="delete"
                                 Clicked="DeleteConfirmedClick"
                                 Style="{StaticResource PopupActionDeleteButtonStyle}" />
                    <dx:DXBorder Style="{StaticResource SeparatorStyle}" />
                    <dx:DXButton Content="Cancelar"
                                 Icon="cancel"
                                 Clicked="CancelDeleteClick"
                                 Style="{StaticResource PopupActionButtonStyle}" />
                </dx:DXStackLayout>
            </dxcn:DXPopup>
        </dx:DXStackLayout>
    </ScrollView>

        <!-- Barra de navegacion entre productos (anterior / siguiente) -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*"
              ColumnSpacing="12"
              Padding="14,8,14,14"
              BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
            <Button Grid.Column="0"
                    Text="◀ Anterior"
                    Clicked="PreviousItemClick"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="48"
                    FontAttributes="Bold" />
            <Button Grid.Column="1"
                    Text="Siguiente ▶"
                    Clicked="NextItemClick"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="48"
                    FontAttributes="Bold" />
        </Grid>
    </Grid>
</ContentPage>
