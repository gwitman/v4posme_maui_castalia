<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="v4posme_maui.Views.Items.ItemEditPage"
             xmlns:dxdf="clr-namespace:DevExpress.Maui.DataForm;assembly=DevExpress.Maui.Editors"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dxco="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             Title="Editar Producto"
             Style="{StaticResource DetailPageStyle}">
    <ContentPage.Triggers>
        <DataTrigger Binding="{Binding IsNew}" Value="True" TargetType="ContentPage">
            <Setter Property="Title" Value="Agregar Producto" />
            <Setter Property="BackgroundColor"
                    Value="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}" />
        </DataTrigger>
    </ContentPage.Triggers>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="barcode_scan" Clicked="SimpleButton_OnClicked" />
        <ToolbarItem IconImageSource="save" Clicked="SaveItemClick" />
    </ContentPage.ToolbarItems>
    <Grid>
        <ScrollView>
            <dx:DXStackLayout Orientation="Vertical" Padding="0,0,0,20">
                <dxco:DXPopup x:Name="Popup"
                              AllowScrim="True"
                              BackgroundColor="Red"
                              VerticalAlignment="Bottom"
                              HorizontalAlignment="Stretch"
                              Margin="16"
                              CornerRadius="16"
                              ScrimColor="#b3adb9ce">
                    <StackLayout WidthRequest="250" Padding="4">
                        <Label x:Name="TxtMensaje"
                               FontAttributes="Bold"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               TextColor="{StaticResource White}"
                               Margin="20, 20" />
                        <Button Text="Aceptar"
                                Clicked="ClosePopup_Clicked"
                                BackgroundColor="{StaticResource Gray600}"
                                CornerRadius="12"
                                HeightRequest="46"
                                FontSize="18"
                                TextColor="White" />
                    </StackLayout>
                </dxco:DXPopup>

                <!-- Encabezado con avatar (solo edicion) -->
                <dx:DXStackLayout Orientation="Vertical">
                    <dx:DXStackLayout.Triggers>
                        <DataTrigger Binding="{Binding IsNew}" Value="True" TargetType="dx:DXStackLayout">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </dx:DXStackLayout.Triggers>
                    <dx:DXBorder BackgroundColor="{StaticResource Primary}"
                                 CornerRadius="0,0,28,28"
                                 BorderThickness="0"
                                 Padding="0,18,0,22">
                        <dx:DXBorder WidthRequest="120"
                                     HeightRequest="120"
                                     CornerRadius="60"
                                     BorderThickness="0"
                                     HorizontalOptions="Center"
                                     BackgroundColor="#33FFFFFF">
                            <dx:DXImage Source="product_item"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        Aspect="AspectFit" />
                        </dx:DXBorder>
                    </dx:DXBorder>
                </dx:DXStackLayout>

                <dx:DXBorder
                    Margin="14,16,14,14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}"
                    BorderThickness="0" CornerRadius="16">
                    <dx:DXBorder.Shadow>
                        <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="14" Offset="0,4" />
                    </dx:DXBorder.Shadow>
                    <dxdf:DataFormView x:Name="DataForm" DataObject="{Binding Item}"
                                       EditorLabelColor="{StaticResource Primary}"
                                       EditorLabelWidth="0"
                                       IsAutoGenerationEnabled="False"
                                       ValidationMode="LostFocus"
                                       ValidateForm="DataForm_OnValidateForm"
                                       Margin="6,10,6,6" Background="Transparent">
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                x:Name="TxtBarCode"
                                IconColor="#006E98"
                                StartIcon="barcode"
                                IsErrorIconVisible="True"
                                Text="{Binding BarCode}"
                                ErrorText="No puede estar vacío"
                                LabelText="Código de barra" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                x:Name="TextItemNumber"
                                IconColor="#006E98"
                                StartIcon="quantity"
                                Text="{Binding ItemNumber}"
                                ErrorText="No puede estar vacío"
                                LabelText="Código de producto" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                x:Name="TextName"
                                IconColor="#006E98"
                                StartIcon="textbox"
                                Text="{Binding Name}"
                                ErrorText="No puede estar vacío"
                                LabelText="Descripción del producto" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                x:Name="TextPrecioPublico"
                                Keyboard="Numeric"
                                IconColor="#006E98"
                                StartIcon="price"
                                ErrorText="No puede estar vacío"
                                Text="{Binding PrecioPublico}"
                                LabelText="Precio al publico" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                x:Name="TextCantidadFinal"
                                Keyboard="Numeric"
                                IsReadOnly="True"
                                IconColor="#006E98"
                                StartIcon="quantity"
                                Text="{Binding CantidadFinal}"
                                LabelText="Existencia total" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit                                
                                x:Name="TextCantidadFacturadas"
                                Keyboard="Numeric"
                                IconColor="#006E98"
                                StartIcon="quantity"
                                Text="{Binding CantidadFacturadas}"
                                IsReadOnly="True"
                                LabelText="Cantidad facturadas" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                TextChanged="TextCantidadEntrada_OnTextChanged"
                                x:Name="TextCantidadEntrada"
                                Keyboard="Numeric"
                                IconColor="#2E7D32"
                                StartIcon="quantity"
                                TextColor="#2E7D32"
                                TextFontAttributes="Bold"
                                Text="{Binding CantidadEntradas}"
                                LabelText="Cantidad a ingresar" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                TextChanged="TextCantidadEntrada_OnTextChanged"
                                x:Name="TextCantidadSalida"
                                Keyboard="Numeric"
                                IconColor="#C62828"
                                StartIcon="quantity"
                                TextColor="#C62828"
                                TextFontAttributes="Bold"
                                Text="{Binding CantidadSalidas}"
                                LabelText="Cantidad a retirar" />
                        </dxdf:DataFormCustomItem>
                        <dxdf:DataFormCustomItem>
                            <dxe:TextEdit
                                Keyboard="Numeric"
                                IconColor="#006E98"
                                IsReadOnly="True"
                                StartIcon="quantity"
                                Text="{Binding Quantity}"
                                LabelText="Cantidad inicial" />
                        </dxdf:DataFormCustomItem>
                    </dxdf:DataFormView>
                </dx:DXBorder>
            </dx:DXStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
