<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:local="clr-namespace:v4posme_maui.ViewModels"
             xmlns:models="clr-namespace:v4posme_maui.Models"
             Title="{Binding Title}"
             IconImageSource="browse"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:items="clr-namespace:v4posme_maui.Views.Items"
             ios:Page.UseSafeArea="true"
             x:Class="v4posme_maui.Views.Items.ItemsPage">
    <ContentPage.BindingContext>
        <local:PosMeItemsViewModel />
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="barcode_scan" Command="{Binding OnBarCode}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <controls:ShimmerView
            Style="{StaticResource ShimmerEffect}"
            IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <Grid
                    RowDefinitions="Auto,*"
                    HorizontalOptions="Center">
                    <dxe:TextEdit x:Name="SearchBar"
                                  Margin="5"
                                  StartIcon="search"
                                  Text="{Binding Search}"
                                  StartIconCommand="{Binding SearchCommand}"
                                  ReturnCommand="{Binding SearchCommand}"
                                  TextChangedCommand="{Binding ChangeValueCommand}"
                                  PlaceholderText="Buscar por código, código de barra y descripción" />


                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout>
                            <dxcv:DXCollectionView
                                x:Name="ItemsListView"
                                DetailFormTemplate="{DataTemplate  items:ItemDetailPage}"
                                DetailEditFormTemplate="{DataTemplate items:ItemEditPage}"
                                DetailNewItemFormTemplate="{DataTemplate items:ItemEditPage}"
                                ItemsSource="{Binding Items}"
                                SelectedItem="{Binding SelectedItem}"
                                SelectionMode="Single"
                                IsRefreshing="{Binding IsBusy, Mode=TwoWay}"
                                IsLoadMoreEnabled="True"
                                LoadMoreCommand="{Binding LoadMoreCommand}"
                                TapCommand="{Binding Source={x:Reference ItemsListView}, Path=Commands.ShowDetailForm}">
                                <dxcv:DXCollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <dxc:DXStackLayout
                                            CornerRadius="12"
                                            Margin="8,4">
                                            <Grid x:DataType="models:Api_AppMobileApi_GetDataDownloadItemsResponse"
                                                  HorizontalOptions="Fill"
                                                  Padding="12"
                                                  VerticalOptions="Fill"
                                                  ColumnSpacing="10"
                                                  RowSpacing="4"
                                                  BackgroundColor="{StaticResource Primary}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Icono del producto -->
                                                <Border
                                                    StrokeShape="RoundRectangle 8"
                                                    Stroke="Transparent"
                                                    BackgroundColor="#33FFFFFF"
                                                    WidthRequest="52"
                                                    HeightRequest="52"
                                                    Padding="6"
                                                    Grid.Column="0"
                                                    Grid.RowSpan="4"
                                                    VerticalOptions="Center">
                                                    <dxc:DXImage WidthRequest="40"
                                                                 HeightRequest="40"
                                                                 Source="package_item.svg"
                                                                 Aspect="AspectFit" />
                                                </Border>

                                                <!-- Nombre del producto -->
                                                <Label Grid.Column="1" Grid.Row="0"
                                                       Grid.ColumnSpan="2"
                                                       FontAttributes="Bold"
                                                       FontSize="15"
                                                       TextColor="White"
                                                       LineBreakMode="TailTruncation"
                                                       Text="{Binding Name}" />

                                                <!-- Código de barra -->
                                                <Label Grid.Column="1" Grid.Row="1"
                                                       FontSize="13"
                                                       TextColor="#CCFFFFFF"
                                                       Text="{Binding BarCode}" />

                                                <!-- Número de artículo -->
                                                <Label Grid.Column="2" Grid.Row="1"
                                                       FontSize="13"
                                                       TextColor="#CCFFFFFF"
                                                       HorizontalOptions="End"
                                                       Text="{Binding ItemNumber}" />

                                                <!-- Precio -->
                                                <HorizontalStackLayout Grid.Column="1" Grid.Row="2">
                                                    <Label Text="Precio: "
                                                           FontSize="13"
                                                           TextColor="#CCFFFFFF" />
                                                    <Label Text="{Binding PrecioPublico, StringFormat='C$ {0:N2}'}"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           TextColor="White" />
                                                </HorizontalStackLayout>

                                                <!-- Existencia -->
                                                <Border Grid.Column="2" Grid.Row="2"
                                                        Grid.RowSpan="2"
                                                        StrokeShape="RoundRectangle 8"
                                                        Stroke="Transparent"
                                                        BackgroundColor="#33FFFFFF"
                                                        Padding="8,4"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="End">
                                                    <VerticalStackLayout HorizontalOptions="Center">
                                                        <Label Text="Existencia"
                                                               FontSize="10"
                                                               TextColor="#CCFFFFFF"
                                                               HorizontalTextAlignment="Center" />
                                                        <Label Text="{Binding CantidadFinal, StringFormat='{0:N2}'}"
                                                               FontSize="16"
                                                               FontAttributes="Bold"
                                                               TextColor="White"
                                                               HorizontalTextAlignment="Center" />
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        NumberOfTapsRequired="1"
                                                        Command="{Binding Source={x:Reference ItemsListView}, Path=Commands.ShowDetailForm}"
                                                        CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                            </Grid>
                                        </dxc:DXStackLayout>
                                    </DataTemplate>
                                </dxcv:DXCollectionView.ItemTemplate>
                            </dxcv:DXCollectionView>
                        </VerticalStackLayout>
                    </ScrollView>
                    <Button Text="+"
                            Grid.Row="1"
                            BackgroundColor="OrangeRed"
                            TextColor="White"
                            CornerRadius="28"
                            FontAttributes="Bold"
                            FontSize="30"
                            WidthRequest="56"
                            HeightRequest="56"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="20"
                            Command="{Binding Source={x:Reference ItemsListView}, Path=Commands.ShowDetailNewItemForm}"
                            ZIndex="1" />
                </Grid>

            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>