<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:invoices="clr-namespace:v4posme_maui.ViewModels.Invoices"
             xmlns:dxdf="clr-namespace:DevExpress.Maui.DataForm;assembly=DevExpress.Maui.Editors"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             Title="{Binding Title}"
             x:Class="v4posme_maui.Views.Invoices.DataInvoicesPage">
    <ContentPage.BindingContext>
        <invoices:DataInvoicesViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Content>
        <controls:ShimmerView
            Style="{StaticResource ShimmerEffect}"
            IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <Grid>
                <ScrollView BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}">
                    <StackLayout Padding="0,0,0,20">
                        <dx:DXBorder BackgroundColor="{StaticResource Primary}"
                                     CornerRadius="0,0,28,28"
                                     BorderThickness="0"
                                     Padding="0,18,0,22">
                            <dx:DXBorder WidthRequest="120"
                                         HeightRequest="120"
                                         CornerRadius="60"
                                         BorderThickness="0"
                                         HorizontalOptions="Center"
                                         BackgroundColor="#33FFFFFF">
                                <dx:DXImage Source="invoice_green"
                                            WidthRequest="80"
                                            HeightRequest="80"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Aspect="AspectFit" />
                            </dx:DXBorder>
                        </dx:DXBorder>
                        <dx:DXBorder
                            Margin="14,16,14,14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}"
                            BorderThickness="0" CornerRadius="16">
                            <dx:DXBorder.Shadow>
                                <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="14" Offset="0,4" />
                            </dx:DXBorder.Shadow>
                            <Grid RowSpacing="15" Padding="14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Cargar solicitud: visible solo si INVOICE_MOBILE_SHOW_LOAD_ORDER = true (requiere internet) -->
                                <Button
                                    Grid.Row="10"
                                    Text="Cargar solicitud"
                                    IsVisible="{Binding MostrarCargarSolicitud}"
                                    Command="{Binding AbrirCargarSolicitudCommand}"
                                    BackgroundColor="#E67E22"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="46" />
                                <dxe:TextEdit
                                    Grid.Row="0"
                                    x:Name="TxtCustomer"
                                    IsReadOnly="True"
                                    IconColor="{StaticResource Primary}"
                                    StartIcon="person"
                                    Text="{Binding Item.NombreCompleto}"
                                    LabelText="Nombre completo" />
                                <dxe:TextEdit
                                    Grid.Row="1"
                                    IconColor="{StaticResource Primary}"
                                    HasError="{Binding ErrorComentarios}"
                                    x:Name="Txtcomentarios"
                                    IsErrorIconVisible="{Binding ErrorComentarios}"
                                    StartIcon="identificacion"
                                    Text="{Binding Comentarios}"
                                    LabelText="{Binding EtiquetaComentario}" />
                                <dxe:TextEdit
                                    Grid.Row="2"
                                    IconColor="{StaticResource Primary}"
                                    HasError="{Binding ErrorReferencia}"
                                    x:Name="TxtReferencia"
                                    IsErrorIconVisible="{Binding ErrorReferencia}"
                                    StartIcon="identificacion"
                                    Text="{Binding Referencias}"
                                    LabelText="Referencia" />

                                <dxe:TextEdit
                                    Grid.Row="3"
                                    IconColor="{StaticResource Primary}"
                                    HasError="{Binding ErrorReferenceClientName}"
                                    x:Name="TxtReferenceClientName"
                                    IsErrorIconVisible="{Binding ErrorReferenceClientName}"
                                    StartIcon="identificacion"
                                    Text="{Binding ReferenceClientName}"
                                    LabelText="{Binding EtiquetaClienteReferencia}"
                                    IsVisible="{Binding MostrarClienteReferencia}" />

                                <dxe:TextEdit
                                    Grid.Row="4"
                                    IconColor="{StaticResource Primary}"
                                    x:Name="TxtReferenceClientIdentifier"
                                    StartIcon="identificacion"
                                    MaxCharacterCount="50"
                                    Text="{Binding ReferenceClientIdentifier}"
                                    LabelText="{Binding EtiquetaCedula}"
                                    IsVisible="{Binding MostrarCedula}" />

                                <dxe:TextEdit
                                    Grid.Row="5"
                                    IconColor="{StaticResource Primary}"
                                    x:Name="TxtNumberPhone"
                                    StartIcon="identificacion"
                                    Keyboard="Telephone"
                                    MaxCharacterCount="250"
                                    Text="{Binding NumberPhone}"
                                    LabelText="{Binding EtiquetaTelefono}"
                                    IsVisible="{Binding MostrarTelefono}" />

                                <dxe:ComboBoxEdit
                                    Grid.Row="6"
                                    SelectedItem="{Binding SelectedCurrency}"
                                    HasError="{Binding ErrorCurrency}"
                                    IsLabelFloating="True"
                                    StartIcon="price"
                                    LabelText="{Binding EtiquetaMoneda}"
                                    IsVisible="{Binding MostrarMoneda}"
                                    ItemsSource="{Binding Currencies}" />

                                <dxe:ComboBoxEdit
                                    Grid.Row="7"
                                    SelectedItem="{Binding SelectedTipoDocumento}"
                                    HasError="{Binding ErrorTipoDocumento}"
                                    StartIcon="identificacion"
                                    IsLabelFloating="True"
                                    LabelText="{Binding EtiquetaTipoDocumento}"
                                    IsVisible="{Binding MostrarTipoDocumento}"
                                    ItemsSource="{Binding TipoDocumentos}" />

                                <dxe:ComboBoxEdit
                                    Grid.Row="8"
                                    SelectedItem="{Binding SelectedMesa}"
                                    HasError="{Binding ErrorMesa}"
                                    IsLabelFloating="True"
                                    StartIcon="price"
                                    LabelText="{Binding EtiquetaMesa}"
                                    IsVisible="{Binding MostrarMesa}"
                                    ItemsSource="{Binding Mesas}" />

                                <dxe:ComboBoxEdit
                                    Grid.Row="9"
                                    SelectedItem="{Binding SelectedZona}"
                                    IsLabelFloating="True"
                                    StartIcon="price"
                                    LabelText="{Binding EtiquetaZona}"
                                    IsVisible="{Binding MostrarZona}"
                                    ItemsSource="{Binding Zonas}" />

                                <dx:DXButton
                                    Grid.Row="11"
                                    Content="Más opciones"
                                    Command="{Binding SeleccionarInvoiceCreditCommand}" />
                            </Grid>
                        </dx:DXBorder>
                    </StackLayout>
                </ScrollView>
                <!-- Popup "Cargar solicitud" (estilo de marca posMe, igual que 08PrinterInvoicePage) -->
                <controls:DXPopup x:Name="CargarSolicitudPopup"
                                  AllowScrim="True"
                                  BackgroundColor="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  CornerRadius="20"
                                  ScrimColor="#99000000"
                                  IsOpen="{Binding MostrarPopupCargarSolicitud, Mode=TwoWay}">
                    <dx:DXStackLayout WidthRequest="300"
                                      Padding="24"
                                      ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56"
                                     WidthRequest="56"
                                     CornerRadius="28"
                                     HorizontalOptions="Center"
                                     BackgroundColor="#FDF0E3">
                            <Label Text="&#x2193;"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#E67E22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="Cargar solicitud"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                        <dxe:TextEdit Text="{Binding NumeroSolicitud}"
                                      LabelText="Número de solicitud" />
                        <ActivityIndicator IsRunning="{Binding CargandoSolicitud}"
                                           IsVisible="{Binding CargandoSolicitud}"
                                           HeightRequest="32"
                                           WidthRequest="32" />
                        <Label Text="{Binding MensajeSolicitud}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                        <Grid ColumnSpacing="12"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Text="Cancelar"
                                    Command="{Binding CancelarCargarSolicitudCommand}"
                                    BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource Gray900}"
                                    CornerRadius="12"
                                    HeightRequest="46" />
                            <Button Grid.Column="1"
                                    Text="Cargar"
                                    Command="{Binding CargarSolicitudCommand}"
                                    BackgroundColor="#E67E22"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="46" />
                        </Grid>
                    </dx:DXStackLayout>
                </controls:DXPopup>
                </Grid>
            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>