<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:core="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:editors="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
             x:Class="v4posme_maui.Views.Invoices.ModificarValorPage">
    <ContentPage.Content>
        <core:DXStackLayout
            Padding="20,40,20,0"
            Orientation="Vertical"
            VerticalOptions="Start"
            HorizontalOptions="Fill"
            ItemSpacing="24">
            <core:DXBorder WidthRequest="120"
                           HeightRequest="120"
                           CornerRadius="60"
                           BorderThickness="0"
                           HorizontalOptions="Center"
                           BackgroundColor="#1A006E98">
                <core:DXImage
                    HeightRequest="70"
                    WidthRequest="70"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Aspect="AspectFit"
                    Source="pencil_square"/>
            </core:DXBorder>
            <core:DXBorder
                CornerRadius="16"
                BorderThickness="0"
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardColor}, Dark={StaticResource CardColorDark}}">
                <core:DXBorder.Shadow>
                    <Shadow Brush="{StaticResource Primary}" Opacity="0.15" Radius="14" Offset="0,4" />
                </core:DXBorder.Shadow>
                <core:DXStackLayout Orientation="Vertical" ItemSpacing="18">
                    <editors:TextEdit
                        StartIcon="quantity"
                        IconColor="{StaticResource Primary}"
                        x:Name="TxtValor"
                        Keyboard="Numeric"
                        LabelText="Valor"
                        PlaceholderText="Ingrese valor"/>
                    <core:DXButton
                        Clicked="DXButtonBase_OnClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="50"
                        Content="Aplicar"/>
                </core:DXStackLayout>
            </core:DXBorder>
        </core:DXStackLayout>
    </ContentPage.Content>
</ContentPage>
