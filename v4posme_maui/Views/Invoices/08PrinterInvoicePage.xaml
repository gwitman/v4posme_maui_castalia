<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:invoices="clr-namespace:v4posme_maui.ViewModels.Invoices"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:models="clr-namespace:v4posme_maui.Models"
             xmlns:controls="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
             Title="{Binding Title}"
             x:Class="v4posme_maui.Views.Invoices.PrinterInvoicePage"
             Style="{StaticResource DetailPageStyle}">
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsEnabled="False"
                            IsVisible="False" />
    </Shell.BackButtonBehavior>
    <Shell.PresentationMode>
        Animated
    </Shell.PresentationMode>
    <ContentPage.BindingContext>
        <invoices:PrinterInvoiceViewModel />
    </ContentPage.BindingContext>
    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="shared" Clicked="MenuItem_OnClicked" />
        <ToolbarItem Text="Imprimir" Order="Secondary" x:Name="ItemPrint" Command="{Binding PrintCommand}" />
        <ToolbarItem Text="Nueva Factura" Order="Secondary" Command="{Binding AplicarOtroCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <controls:ShimmerView Style="{StaticResource ShimmerEffect}" IsLoading="{Binding IsBusy}">
            <controls:ShimmerView.Content>
                <Grid>
                <ScrollView>
                    <VerticalStackLayout>
                    <dx:DXStackLayout
                        x:Name="DxStackLayout"
                        BackgroundColor="White"
                        Margin="10">
                        <dx:DXStackLayout
                            Orientation="Vertical">
                            
                            <dx:DXImage x:Name="Logo"
                                        HorizontalOptions="Center"
                                        HeightRequest="150"
                                        WidthRequest="150"
                                        Source="{Binding LogoSource}" />

                            <dx:DXImage x:Name="LogoQr"
                               HorizontalOptions="Center"
                               HeightRequest="150"
                               WidthRequest="150" 
                               IsVisible="{Binding ShowQr}" 
                               Source="{Binding QrImageSource}" />
                            
                            <Label
                                HorizontalTextAlignment="Center"
                                Text="{Binding Company.Name}"
                                FontAttributes="Bold" />
                            <Label
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="RUC" FontAttributes="Bold" />
                                        <Span Text=" : " FontAttributes="Bold" />
                                        <Span Text="{Binding CompanyRuc.Value}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="FACTURA"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <dx:DXBorder HeightRequest="3"
                                         WidthRequest="60"
                                         CornerRadius="2"
                                         BorderThickness="0"
                                         Margin="0,4,0,4"
                                         HorizontalOptions="Center"
                                         BackgroundColor="{StaticResource Secondary}" />
                            <Label
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold"
                                Text="{Binding DtoInvoice.Codigo}" FontSize="14" />
                            <Label
                                HorizontalTextAlignment="Center"
                                FontAttributes="Bold">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Fecha" />
                                        <Span Text=" : " />
                                        <Span
                                            Text="{Binding DtoInvoice.TransactionOn, StringFormat='{0:yyyy-MM-dd hh:mm tt}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <dx:DXBorder
                                Margin="0,10"
                                Padding="16"
                                CornerRadius="12"
                                BorderThickness="1"
                                BorderColor="{StaticResource SeparatorColor}"
                                BackgroundColor="#FAFAFA">
                                <Grid RowSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Row="0" Grid.Column="0" Text="Vendedor:" FontAttributes="Bold" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding CodigoVendedor}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="Codigo:" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding DtoInvoice.Codigo}" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="Tipo:" FontAttributes="Bold" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding DtoInvoice.TipoDocumento.Name}" />
                                    <Label Grid.Row="3" Grid.Column="0" Text="Moneda:" FontAttributes="Bold" />
                                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding SimboloMoneda}" />
                                    <Label Grid.Row="4" Grid.Column="0" Text="Estado:" FontAttributes="Bold" />
                                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding EstadoFactura}" />
                                    <Label Grid.Row="5" Grid.Column="0" Text="Cliente:" FontAttributes="Bold" />
                                    <Label Grid.Row="6"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding NombreCliente}" />
                                    <Label Grid.Row="7"
                                           Grid.ColumnSpan="2"
                                           Grid.Column="0"
                                           Text="{Binding DtoInvoice.Comentarios}" />
                                </Grid>
                            </dx:DXBorder>
                            
                        </dx:DXStackLayout>
                        
                        
                        
                        
                        <dx:DXStackLayout>
                            <dx:DXSeparator />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       Text="Cantidad" />
                                <Label Grid.Column="1"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       Text="Precio" />
                                <Label Grid.Column="2"
                                       HorizontalTextAlignment="Center"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Primary}"
                                       Text="Importe" />
                            </Grid>
                            <dx:DXSeparator />
                            <dx:DXBorder Padding="10">
                                <CollectionView
                                    x:Name="ItemsListView"
                                    VerticalOptions="FillAndExpand"
                                    ItemsSource="{Binding ItemsResponses}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <dx:DXStackLayout Margin="5">
                                                <Grid
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    x:DataType="models:Api_AppMobileApi_GetDataDownloadItemsResponse">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Label
                                                        Grid.Row="0"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                        Text="{Binding Name}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        HorizontalTextAlignment="End"
                                                        Text="{Binding Quantity}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="2"
                                                        HorizontalTextAlignment="End"
                                                        Text="{Binding PrecioPublico}" />
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="3"
                                                        HorizontalTextAlignment="End"
                                                        Text="{Binding Importe}" />
                                                    <Label
                                                        Grid.Row="2"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type invoices:PrinterInvoiceViewModel}}, Path=ShowReferencia}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="Ref: " FontAttributes="Italic" />
                                                                <Span Text="{Binding Referencia}" FontAttributes="Italic" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                    <BoxView
                                                        Grid.Row="3"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                        HeightRequest="1"
                                                        BackgroundColor="{StaticResource Gray200}"
                                                        Margin="0,4,0,0" />
                                                </Grid>
                                            </dx:DXStackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </dx:DXBorder>
                        </dx:DXStackLayout>

                        <dx:DXStackLayout
                            ItemSpacing="5"
                            Margin="20">
                            <Label
                                HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Sub Total: " />
                                        <Span Text="{Binding Moneda}" />
                                        <Span Text="{Binding Amount}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Descuento: " />
                                            <Span Text="{Binding Moneda}" />
                                            <Span Text="{Binding Descuento}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                            </Label>
                            <dx:DXSeparator Margin="0,4" />
                            <Label
                                FontSize="18"
                                HorizontalOptions="End">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="Total: " FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                            <Span Text="{Binding Moneda}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                            <Span Text="{Binding Balance}" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            <Label
                                HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Recibido: " />
                                        <Span Text="{Binding Moneda}" />
                                        <Span Text="{Binding Monto}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label
                                HorizontalOptions="End">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Cambio: " />
                                        <Span Text="{Binding Moneda}" />
                                        <Span Text="{Binding Cambio}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </dx:DXStackLayout>
                        
                        
                        <Label
                            HorizontalTextAlignment="Center"
                            Text="{Binding Company.Address}" />
                        <Label
                            HorizontalOptions="Center"
                            Text="{Binding CompanyTelefono.Value}" />

                        <Button Text="Subir Datos"
                                Command="{Binding MostrarConfirmacionSubidaCommand}"
                                BackgroundColor="#E67E22"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="8"
                                HeightRequest="48"
                                Margin="20,20,20,10" />

                        
                    </dx:DXStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Popup de confirmacion de subida (estilo de marca posMe) -->
                <controls:DXPopup x:Name="ConfirmarSubidaPopup"
                                  AllowScrim="True"
                                  BackgroundColor="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  CornerRadius="20"
                                  ScrimColor="#99000000"
                                  IsOpen="{Binding MostrarConfirmacionSubida}">
                    <dx:DXStackLayout WidthRequest="300"
                                      Padding="24"
                                      ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56"
                                     WidthRequest="56"
                                     CornerRadius="28"
                                     HorizontalOptions="Center"
                                     BackgroundColor="#FDF0E3">
                            <Label Text="&#x2191;"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="#E67E22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="Confirmar subida de datos"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Se subirán los datos al servidor y luego se descargará la información actualizada. ¿Desea continuar?"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                        <Grid ColumnSpacing="12"
                              Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0"
                                    Text="Cancelar"
                                    Clicked="CancelarSubida_Clicked"
                                    BackgroundColor="{StaticResource Gray200}"
                                    TextColor="{StaticResource Gray900}"
                                    CornerRadius="12"
                                    HeightRequest="46" />
                            <Button Grid.Column="1"
                                    Text="Subir"
                                    Clicked="ConfirmarSubida_Clicked"
                                    BackgroundColor="#E67E22"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    HeightRequest="46" />
                        </Grid>
                    </dx:DXStackLayout>
                </controls:DXPopup>

                <!-- Popup de resultado (exito / error / aviso) con estilo de marca -->
                <controls:DXPopup x:Name="ResultadoPopup"
                                  AllowScrim="True"
                                  BackgroundColor="White"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  CornerRadius="20"
                                  ScrimColor="#99000000"
                                  IsOpen="{Binding MostrarResultado}">
                    <dx:DXStackLayout WidthRequest="300"
                                      Padding="24"
                                      ItemSpacing="14">
                        <dx:DXBorder HeightRequest="56"
                                     WidthRequest="56"
                                     CornerRadius="28"
                                     HorizontalOptions="Center"
                                     BackgroundColor="{Binding ResultadoColorSuave}">
                            <Label Text="{Binding ResultadoIcono}"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{Binding ResultadoColor}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </dx:DXBorder>
                        <Label Text="{Binding ResultadoTitulo}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="{Binding ResultadoMensaje}"
                               FontSize="14"
                               TextColor="{StaticResource Gray600}"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Aceptar"
                                Clicked="CerrarResultado_Clicked"
                                BackgroundColor="{Binding ResultadoColor}"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="46"
                                Margin="0,6,0,0" />
                    </dx:DXStackLayout>
                </controls:DXPopup>
                </Grid>
            </controls:ShimmerView.Content>
            <controls:ShimmerView.LoadingView>
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       HorizontalOptions="Center"
                                       HeightRequest="50"
                                       WidthRequest="50" />
                    <Label Text="{Binding LoadingMessage}"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold" />
                </VerticalStackLayout>
            </controls:ShimmerView.LoadingView>
        </controls:ShimmerView>
    </ContentPage.Content>
</ContentPage>