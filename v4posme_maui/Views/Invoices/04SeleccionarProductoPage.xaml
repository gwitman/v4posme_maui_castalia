<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:invoices="clr-namespace:v4posme_maui.ViewModels.Invoices"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:dxcv="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dxe="clr-namespace:DevExpress.Maui.Editors;assembly=DevExpress.Maui.Editors"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.Invoices.SeleccionarProductoPage">
    <ContentPage.BindingContext>
        <invoices:SeleccionarProductoViewModel />
    </ContentPage.BindingContext>
    <!-- La 4/6 es la pantalla base del flujo de facturacion rapida: no se debe regresar a
         la lista de clientes (1/6). En lugar de ocultar el icono superior izquierdo, se
         reemplaza el boton atras por un boton de menu (drawer) que abre el menu principal
         (flyout) del Shell. Asi el usuario siempre tiene acceso visible al menu principal. -->
    <Shell.BackButtonBehavior>
        <BackButtonBehavior IconOverride="drawer_button"
                            Command="{Binding AbrirMenuPrincipalCommand}" />
    </Shell.BackButtonBehavior>
    <!-- Menu desplegable (overflow ⋮) para modificar los datos de las pantallas anteriores -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Nueva factura"
                     Order="Secondary"
                     Command="{Binding NuevaFacturaCommand}" />
        <ToolbarItem Text="Seleccionar cliente"
                     Order="Secondary"
                     Command="{Binding IrSeleccionClienteCommand}" />
        <ToolbarItem Text="Datos de facturación"
                     Order="Secondary"
                     Command="{Binding IrDatosFacturaCommand}" />
        <ToolbarItem Text="Datos de crédito"
                     Order="Secondary"
                     Command="{Binding IrDatosCreditoCommand}" />
    </ContentPage.ToolbarItems>
    <ContentPage.Resources>
        <converters:ToLowerConverter x:Key="ToLowerConverter" />
        <converters:ItemImageConverter x:Key="ItemImageConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <dxc:ShimmerView Style="{StaticResource ShimmerEffect}"
                         IsLoading="{Binding IsBusy}">
            <dxc:ShimmerView.Content>
                <AbsoluteLayout>
                    <Grid AbsoluteLayout.LayoutFlags="All"
                          AbsoluteLayout.LayoutBounds="0, 0, 1, 1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Barra de búsqueda -->
                        <Grid Grid.Row="0"
                              Padding="12,10"
                              ColumnSpacing="8"
                              BackgroundColor="{StaticResource White}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <dxe:TextEdit
                                Grid.Column="0"
                                Style="{StaticResource SearchEditorStyle}"
                                PlaceholderText="Buscar producto..."
                                ReturnType="Search"
                                ReturnCommand="{Binding SearchCommand}"
                                EndIconCommand="{Binding SearchCommand}"
                                Text="{Binding Search}" />
                            <dx:DXButton
                                Grid.Column="1"
                                Style="{StaticResource SinFondoColorRedondeado}"
                                IconHeight="24"
                                IconWidth="24"
                                Command="{Binding SearchBarCodeCommand}"
                                Icon="barcode_scaner" />
                        </Grid>

                        <!-- Lista de productos (vista clasica, una columna). Se muestra cuando
                             APP_MOBILE_FORM_SHOW_INVOICE no es "restaurant". -->
                        <dxcv:DXCollectionView
                            Grid.Row="1"
                            x:Name="ProductosCollectionView"
                            IsVisible="{Binding EsVistaClasica}"
                            ItemsSource="{Binding Productos}"
                            ItemSeparatorThickness="0">
                            <dxcv:DXCollectionView.ItemTemplate>
                                <DataTemplate>
                                    <SwipeView>
                                        <SwipeView.LeftItems>
                                            <SwipeItems Mode="Execute">
                                                <SwipeItem Text="Quitar"
                                                           BackgroundColor="#E53935"
                                                           Command="{Binding BindingContext.QuitarProductoCommand, Source={x:Reference ProductosCollectionView}}"
                                                           CommandParameter="{Binding .}" />
                                            </SwipeItems>
                                        </SwipeView.LeftItems>
                                        <dx:DXBorder
                                            Margin="12,6"
                                            Padding="12"
                                            CornerRadius="12"
                                            BorderThickness="0"
                                            BackgroundColor="{StaticResource White}">
                                            <dx:DXBorder.Shadow>
                                                <Shadow Brush="{StaticResource Gray300Brush}"
                                                        Offset="0,2"
                                                        Radius="6"
                                                        Opacity="0.35" />
                                            </dx:DXBorder.Shadow>
                                            <dx:DXBorder.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding BindingContext.AnadirProducto, Source={x:Reference ProductosCollectionView}}"
                                                    CommandParameter="{Binding .}" />
                                            </dx:DXBorder.GestureRecognizers>
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!-- Icono del producto -->
                                                <dx:DXBorder
                                                    Grid.Column="0"
                                                    Grid.RowSpan="2"
                                                    WidthRequest="48"
                                                    HeightRequest="48"
                                                    CornerRadius="10"
                                                    BackgroundColor="{StaticResource PageBackground}"
                                                    BorderThickness="0"
                                                    VerticalOptions="Center">
                                                    <dx:DXImage
                                                        Source="products_50x"
                                                        WidthRequest="28"
                                                        HeightRequest="28"
                                                        TintColor="{StaticResource Primary}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                </dx:DXBorder>

                                                <!-- Nombre del producto en minúsculas -->
                                                <Label
                                                    Grid.Column="1"
                                                    Grid.Row="0"
                                                    Text="{Binding Name, Converter={StaticResource ToLowerConverter}}"
                                                    FontSize="15"
                                                    FontFamily="OpenSansRegular"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2"
                                                    VerticalOptions="End" />

                                                <!-- Código del producto -->
                                                <Label
                                                    Grid.Column="1"
                                                    Grid.Row="1"
                                                    Text="{Binding ItemNumber}"
                                                    FontSize="12"
                                                    TextColor="{StaticResource Gray400}"
                                                    VerticalOptions="Start" />

                                                <!-- Precio -->
                                                <StackLayout
                                                    Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    Spacing="2">
                                                    <Label
                                                        HorizontalTextAlignment="End"
                                                        FontSize="16"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource Primary}">
                                                        <Label.FormattedText>
                                                            <FormattedString>
                                                                <Span Text="{Binding MonedaSimbolo}"
                                                                      FontSize="12"
                                                                      FontAttributes="None"
                                                                      TextColor="{StaticResource Gray400}" />
                                                                <Span Text=" " />
                                                                <Span Text="{Binding PrecioPublico, StringFormat='{0:N2}'}" />
                                                            </FormattedString>
                                                        </Label.FormattedText>
                                                    </Label>
                                                </StackLayout>

                                                <!-- Boton de detalle: abre el popup para indicar
                                                     cantidad y precio antes de agregar. -->
                                                <dx:DXButton
                                                    Grid.Column="3"
                                                    Grid.RowSpan="2"
                                                    Style="{StaticResource SinFondoColorRedondeado}"
                                                    IconHeight="22"
                                                    IconWidth="22"
                                                    Icon="edit"
                                                    VerticalOptions="Center"
                                                    Command="{Binding BindingContext.DetalleProductoCommand, Source={x:Reference ProductosCollectionView}}"
                                                    CommandParameter="{Binding .}" />
                                            </Grid>
                                        </dx:DXBorder>
                                    </SwipeView>
                                </DataTemplate>
                            </dxcv:DXCollectionView.ItemTemplate>
                        </dxcv:DXCollectionView>

                        <!-- Lista de productos (vista restaurante, dos columnas de tarjetas con
                             imagen). Se muestra cuando APP_MOBILE_FORM_SHOW_INVOICE == "restaurant".
                             Reutiliza los mismos comandos (AnadirProducto, QuitarProductoCommand,
                             DetalleProductoCommand) para no cambiar la funcionalidad. -->
                        <dxcv:DXCollectionView
                            Grid.Row="1"
                            x:Name="ProductosRestauranteView"
                            IsVisible="{Binding EsVistaRestaurante}"
                            ItemsSource="{Binding Productos}"
                            Orientation="Vertical"
                            ItemSpanCount="{Binding ColumnasRestaurante}"
                            ItemSeparatorThickness="0">
                            <dxcv:DXCollectionView.ItemTemplate>
                                <DataTemplate>
                                    <dx:DXBorder
                                        Margin="8,8"
                                        Padding="0"
                                        CornerRadius="16"
                                        BorderThickness="0"
                                        BackgroundColor="{StaticResource White}">
                                        <dx:DXBorder.Shadow>
                                            <Shadow Brush="{StaticResource Gray300Brush}"
                                                    Offset="0,2"
                                                    Radius="8"
                                                    Opacity="0.35" />
                                        </dx:DXBorder.Shadow>
                                        <dx:DXBorder.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding BindingContext.AnadirProducto, Source={x:Reference ProductosRestauranteView}}"
                                                CommandParameter="{Binding .}" />
                                        </dx:DXBorder.GestureRecognizers>
                                        <Grid RowSpacing="0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Imagen del producto (desde el servidor).
                                                 Mientras carga o si falla, se ve la imagen por defecto
                                                 que esta debajo (icono de producto). -->
                                            <dx:DXBorder
                                                Grid.Row="0"
                                                CornerRadius="16,16,0,0"
                                                BorderThickness="0"
                                                BackgroundColor="{StaticResource PageBackground}"
                                                IsClippedToBounds="True">
                                                <Grid>
                                                    <!-- Imagen por defecto (icono) de fondo -->
                                                    <dx:DXImage
                                                        Source="product_item"
                                                        WidthRequest="48"
                                                        HeightRequest="48"
                                                        TintColor="{StaticResource Primary}"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center" />
                                                    <!-- Imagen real del producto; si el converter devuelve
                                                         null queda transparente y se ve el icono de fondo. -->
                                                    <Image
                                                        Aspect="AspectFill"
                                                        Source="{Binding ItemId, Converter={StaticResource ItemImageConverter}}" />
                                                </Grid>
                                            </dx:DXBorder>

                                            <!-- Boton de detalle (editar cantidad/precio) sobre la imagen -->
                                            <dx:DXBorder
                                                Grid.Row="0"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                CornerRadius="17"
                                                BorderThickness="0"
                                                BackgroundColor="#E6FFFFFF"
                                                Margin="0,8,8,0"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start">
                                                <dx:DXButton
                                                    Style="{StaticResource SinFondoColorRedondeado}"
                                                    IconHeight="18"
                                                    IconWidth="18"
                                                    Icon="edit"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Command="{Binding BindingContext.DetalleProductoCommand, Source={x:Reference ProductosRestauranteView}}"
                                                    CommandParameter="{Binding .}" />
                                            </dx:DXBorder>

                                            <!-- Datos del producto -->
                                            <StackLayout Grid.Row="1"
                                                         Padding="12,10"
                                                         Spacing="4">
                                                <Label
                                                    Text="{Binding Name, Converter={StaticResource ToLowerConverter}}"
                                                    FontSize="14"
                                                    FontFamily="OpenSansRegular"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="2" />
                                                <Label
                                                    Text="{Binding ItemNumber}"
                                                    FontSize="11"
                                                    TextColor="{StaticResource Gray400}" />
                                                <Label
                                                    FontSize="16"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding MonedaSimbolo}"
                                                                  FontSize="12"
                                                                  FontAttributes="None"
                                                                  TextColor="{StaticResource Gray400}" />
                                                            <Span Text=" " />
                                                            <Span Text="{Binding PrecioPublico, StringFormat='{0:N2}'}" />
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </StackLayout>
                                        </Grid>
                                    </dx:DXBorder>
                                </DataTemplate>
                            </dxcv:DXCollectionView.ItemTemplate>
                        </dxcv:DXCollectionView>

                        <!-- Panel inferior: resumen y acción -->
                        <dx:DXBorder
                            Grid.Row="2"
                            BackgroundColor="{StaticResource White}"
                            CornerRadius="20,20,0,0"
                            BorderThickness="0"
                            Padding="16,12">
                            <dx:DXBorder.Shadow>
                                <Shadow Brush="{StaticResource Gray400Brush}"
                                        Offset="0,-3"
                                        Radius="10"
                                        Opacity="0.2" />
                            </dx:DXBorder.Shadow>
                            <Grid RowSpacing="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>

                                <dx:DXBorder
                                    Grid.Row="0"
                                    Padding="14,10"
                                    CornerRadius="10"
                                    BackgroundColor="{StaticResource PageBackground}"
                                    BorderThickness="0">
                                    <Label
                                        Text="{Binding ProductosSeleccionadosCantidadTotal}"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryDark}"
                                        HorizontalTextAlignment="Center" />
                                </dx:DXBorder>

                                <dx:DXButton
                                    Grid.Row="1"
                                    CornerRadius="12"
                                    Command="{Binding ProductosSeleccionadosCommand}"
                                    Content="{Binding ProductosSeleccionadosCantidad}" />
                            </Grid>
                        </dx:DXBorder>
                    </Grid>

                    <!-- Popup de detalle: cantidad y precio antes de agregar el producto -->
                    <ContentView IsVisible="{Binding DetalleVisible}"
                                 BackgroundColor="#80000000"
                                 AbsoluteLayout.LayoutFlags="All"
                                 AbsoluteLayout.LayoutBounds="0, 0, 1, 1">
                        <dx:DXBorder
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            WidthRequest="320"
                            Padding="24"
                            BackgroundColor="{StaticResource White}"
                            CornerRadius="16"
                            BorderThickness="0">
                            <dx:DXBorder.Shadow>
                                <Shadow Brush="{StaticResource Gray600Brush}"
                                        Offset="0,4"
                                        Radius="16"
                                        Opacity="0.3" />
                            </dx:DXBorder.Shadow>
                            <StackLayout Spacing="16">
                                <Label Text="Detalle del producto"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalOptions="Center" />

                                <Label Text="{Binding DetalleNombre}"
                                       FontSize="14"
                                       TextColor="{StaticResource Gray600}"
                                       HorizontalTextAlignment="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2" />

                                <StackLayout Spacing="4">
                                    <Label Text="Cantidad"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <dxe:TextEdit
                                        Keyboard="Numeric"
                                        PlaceholderText="Cantidad"
                                        Text="{Binding DetalleCantidad}" />
                                </StackLayout>

                                <StackLayout Spacing="4">
                                    <Label Text="Precio"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <dxe:TextEdit
                                        Keyboard="Numeric"
                                        PlaceholderText="Precio"
                                        Text="{Binding DetallePrecio}" />
                                </StackLayout>

                                <!-- Monto: al ingresar un monto (ej. 10) el sistema calcula la
                                     cantidad correspondiente segun el precio (Cantidad = Monto / Precio). -->
                                <StackLayout Spacing="4">
                                    <Label Text="Monto"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}" />
                                    <dxe:TextEdit
                                        Keyboard="Numeric"
                                        PlaceholderText="Monto"
                                        Text="{Binding DetalleMonto}" />
                                </StackLayout>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <dx:DXButton
                                        Grid.Column="0"
                                        Content="Cancelar"
                                        CornerRadius="10"
                                        BackgroundColor="{StaticResource Gray400}"
                                        Command="{Binding CancelarDetalleCommand}" />
                                    <dx:DXButton
                                        Grid.Column="1"
                                        Content="Agregar"
                                        CornerRadius="10"
                                        BackgroundColor="#1B8E3C"
                                        Command="{Binding ConfirmarDetalleCommand}" />
                                </Grid>
                            </StackLayout>
                        </dx:DXBorder>
                    </ContentView>

                    <!-- Popup verde inferior: confirma que se agrego un producto a la factura.
                         Se ancla en la parte inferior (sobre el panel de resumen) y se muestra
                         solo cuando ProductoAgregadoVisible es verdadero. -->
                    <dx:DXBorder
                        IsVisible="{Binding ProductoAgregadoVisible}"
                        AbsoluteLayout.LayoutFlags="PositionProportional,WidthProportional"
                        AbsoluteLayout.LayoutBounds="0.5, 0.88, 0.92, AutoSize"
                        CornerRadius="16"
                        BorderThickness="0"
                        Padding="16,12"
                        BackgroundColor="#1B8E3C">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="#0E5C26"
                                    Offset="0,4"
                                    Radius="14"
                                    Opacity="0.45" />
                        </dx:DXBorder.Shadow>
                        <Grid ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Icono de check en circulo -->
                            <dx:DXBorder
                                Grid.Column="0"
                                WidthRequest="36"
                                HeightRequest="36"
                                CornerRadius="18"
                                BorderThickness="0"
                                BackgroundColor="#33FFFFFF"
                                VerticalOptions="Center">
                                <Label Text="✓"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </dx:DXBorder>

                            <StackLayout Grid.Column="1"
                                         Spacing="2"
                                         VerticalOptions="Center">
                                <Label Text="{Binding ProductoAgregadoMensaje}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource White}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Text="{Binding ProductoAgregadoDetalle}"
                                       FontSize="13"
                                       TextColor="#DFF5E4" />
                            </StackLayout>
                        </Grid>
                    </dx:DXBorder>
                </AbsoluteLayout>
            </dxc:ShimmerView.Content>
            <dxc:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </dxc:ShimmerView.LoadingView>
        </dxc:ShimmerView>
    </ContentPage.Content>
</ContentPage>
