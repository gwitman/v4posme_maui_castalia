<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:invoices="clr-namespace:v4posme_maui.ViewModels.Invoices"
             xmlns:converters="clr-namespace:v4posme_maui.Services.Converters"
             Title="{Binding Title}"
             xmlns:dxc="clr-namespace:DevExpress.Maui.Controls;assembly=DevExpress.Maui.Controls"
             xmlns:collectionView="clr-namespace:DevExpress.Maui.CollectionView;assembly=DevExpress.Maui.CollectionView"
             xmlns:dx="clr-namespace:DevExpress.Maui.Core;assembly=DevExpress.Maui.Core"
             BackgroundColor="{StaticResource PageBackground}"
             x:Class="v4posme_maui.Views.Invoices.RevisarProductosSeleccionadosPage">

    <ContentPage.BindingContext>
        <invoices:RevisarProductosSeleccionadosViewModel />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <converters:ToLowerConverter x:Key="ToLowerConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <dxc:ShimmerView
            Style="{StaticResource ShimmerEffect}"
            IsLoading="{Binding IsBusy}">
            <dxc:ShimmerView.Content>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Lista de productos seleccionados -->
                    <collectionView:DXCollectionView
                        Grid.Row="0"
                        x:Name="CollectionView"
                        TapCommand="{Binding TapCommandProducto}"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionMode="Single"
                        ItemSeparatorThickness="0"
                        ItemsSource="{Binding ProductosSeleccionados}">
                        <collectionView:DXCollectionView.ItemTemplate>
                            <DataTemplate>
                                <StackLayout Spacing="0">
                                    <!-- Card del producto -->
                                    <dx:DXBorder
                                        Margin="12,6"
                                        Padding="14"
                                        CornerRadius="12"
                                        BorderThickness="0"
                                        BackgroundColor="{StaticResource White}">
                                        <dx:DXBorder.Shadow>
                                            <Shadow Brush="{StaticResource Gray300Brush}"
                                                    Offset="0,2"
                                                    Radius="6"
                                                    Opacity="0.35" />
                                        </dx:DXBorder.Shadow>
                                        <dx:DXBorder.Triggers>
                                            <DataTrigger TargetType="dx:DXBorder"
                                                         Binding="{Binding IsSelected}"
                                                         Value="True">
                                                <Setter Property="BackgroundColor"
                                                        Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </dx:DXBorder.Triggers>
                                        <Grid ColumnSpacing="10" RowSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Badge cantidad -->
                                            <dx:DXBorder
                                                Grid.Column="0"
                                                Grid.RowSpan="2"
                                                WidthRequest="40"
                                                HeightRequest="40"
                                                CornerRadius="10"
                                                BackgroundColor="{StaticResource PageBackground}"
                                                BorderThickness="0"
                                                VerticalOptions="Center">
                                                <dx:DXBorder.Triggers>
                                                    <DataTrigger TargetType="dx:DXBorder"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="#FFFFFF30" />
                                                    </DataTrigger>
                                                </dx:DXBorder.Triggers>
                                                <Label
                                                    Text="{Binding Quantity, StringFormat='{0:0.##}'}"
                                                    FontSize="14"
                                                    FontAttributes="Bold"
                                                    TextColor="{StaticResource Primary}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsSelected}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="White" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </dx:DXBorder>

                                            <!-- Nombre del producto -->
                                            <Label
                                                Grid.Column="1"
                                                Grid.Row="0"
                                                Text="{Binding Name, Converter={StaticResource ToLowerConverter}}"
                                                FontSize="14"
                                                FontFamily="OpenSansRegular"
                                                LineBreakMode="TailTruncation"
                                                MaxLines="2"
                                                VerticalOptions="End"
                                                TextColor="Black">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Precio unitario -->
                                            <Label
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                FontSize="12"
                                                TextColor="{StaticResource Gray400}"
                                                VerticalOptions="Start">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding MonedaSimbolo}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding PrecioPublico, StringFormat='{0:N2}'}" />
                                                        <Span Text=" c/u" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="#FFFFFFB0" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Importe total -->
                                            <Label
                                                Grid.Column="2"
                                                Grid.Row="0"
                                                HorizontalTextAlignment="End"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Primary}"
                                                VerticalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding MonedaSimbolo}"
                                                              FontSize="11"
                                                              FontAttributes="None" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding Importe, StringFormat='{0:N2}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="TextColor" Value="White" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>

                                            <!-- Descuento -->
                                            <Label
                                                Grid.Column="2"
                                                Grid.Row="1"
                                                HorizontalTextAlignment="End"
                                                FontSize="11"
                                                TextColor="#E53935"
                                                VerticalOptions="Start">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="-" />
                                                        <Span Text="{Binding MonedaSimbolo}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding MontoDescuento, StringFormat='{0:N2}'}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                            <!-- Panel de acciones expandible -->
                                            <Grid
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="2"
                                                IsVisible="{Binding IsSelected}"
                                                Padding="0,8,0,0"
                                                ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <dx:DXButton
                                                    Grid.Column="0"
                                                    Command="{Binding BindingContext.QuantityCommand, Source={x:Reference CollectionView}}"
                                                    CommandParameter="{Binding .}"
                                                    CornerRadius="8"
                                                    BackgroundColor="{StaticResource PageBackground}"
                                                    Padding="6">
                                                    <StackLayout Spacing="4">
                                                        <dx:DXImage
                                                            HeightRequest="26"
                                                            WidthRequest="26"
                                                            Source="closed_package"
                                                            HorizontalOptions="Center" />
                                                        <Label
                                                            HorizontalTextAlignment="Center"
                                                            Text="{Binding Quantity, StringFormat='{0:0.##}'}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource PrimaryDark}" />
                                                    </StackLayout>
                                                </dx:DXButton>
                                                <dx:DXButton
                                                    Grid.Column="1"
                                                    Command="{Binding BindingContext.PrecioCommand, Source={x:Reference CollectionView}}"
                                                    CommandParameter="{Binding .}"
                                                    CornerRadius="8"
                                                    BackgroundColor="{StaticResource PageBackground}"
                                                    Padding="6">
                                                    <StackLayout Spacing="4">
                                                        <dx:DXImage
                                                            HeightRequest="26"
                                                            WidthRequest="26"
                                                            Source="dollar"
                                                            HorizontalOptions="Center" />
                                                        <Label
                                                            HorizontalTextAlignment="Center"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource PrimaryDark}">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding MonedaSimbolo}" FontSize="9" />
                                                                    <Span Text=" " />
                                                                    <Span Text="{Binding PrecioPublico, StringFormat='{0:N2}'}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                    </StackLayout>
                                                </dx:DXButton>
                                                <dx:DXButton
                                                    Grid.Column="2"
                                                    Command="{Binding BindingContext.DescuentoCommand, Source={x:Reference CollectionView}}"
                                                    CommandParameter="{Binding .}"
                                                    IsVisible="{Binding BindingContext.MostrarDescuento, Source={x:Reference CollectionView}}"
                                                    CornerRadius="8"
                                                    BackgroundColor="{StaticResource PageBackground}"
                                                    Padding="6">
                                                    <StackLayout Spacing="4">
                                                        <dx:DXImage
                                                            TintColor="#E53935"
                                                            HeightRequest="26"
                                                            WidthRequest="26"
                                                            Source="discount"
                                                            HorizontalOptions="Center" />
                                                        <Label
                                                            HorizontalTextAlignment="Center"
                                                            Text="{Binding PorcentajeDescuento, StringFormat='{0:0.##}%'}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="#E53935" />
                                                    </StackLayout>
                                                </dx:DXButton>
                                                <dx:DXButton
                                                    Grid.Column="3"
                                                    Command="{Binding BindingContext.ReferenciaCommand, Source={x:Reference CollectionView}}"
                                                    CommandParameter="{Binding .}"
                                                    CornerRadius="8"
                                                    BackgroundColor="{StaticResource PageBackground}"
                                                    Padding="6">
                                                    <StackLayout Spacing="4">
                                                        <dx:DXImage
                                                            HeightRequest="26"
                                                            WidthRequest="26"
                                                            Source="note"
                                                            HorizontalOptions="Center" />
                                                        <Label
                                                            HorizontalTextAlignment="Center"
                                                            Text="{Binding Referencia}"
                                                            FontSize="11"
                                                            FontAttributes="Bold"
                                                            TextColor="{StaticResource PrimaryDark}"
                                                            LineBreakMode="TailTruncation"
                                                            MaxLines="1" />
                                                    </StackLayout>
                                                </dx:DXButton>
                                            </Grid>
                                        </Grid>
                                    </dx:DXBorder>
                                </StackLayout>
                            </DataTemplate>
                        </collectionView:DXCollectionView.ItemTemplate>
                    </collectionView:DXCollectionView>

                    <!-- Panel inferior: total y acciones -->
                    <dx:DXBorder
                        Grid.Row="1"
                        BackgroundColor="{StaticResource White}"
                        CornerRadius="20,20,0,0"
                        BorderThickness="0"
                        Padding="16,14">
                        <dx:DXBorder.Shadow>
                            <Shadow Brush="{StaticResource Gray400Brush}"
                                    Offset="0,-3"
                                    Radius="10"
                                    Opacity="0.2" />
                        </dx:DXBorder.Shadow>
                        <StackLayout Spacing="10">
                            <!-- Resumen -->
                            <dx:DXBorder
                                Padding="14,10"
                                CornerRadius="10"
                                BackgroundColor="{StaticResource PageBackground}"
                                BorderThickness="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Text="TOTAL"
                                        FontSize="15"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryDark}"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="18"
                                        FontAttributes="Bold"
                                        TextColor="{StaticResource PrimaryDark}"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding MonedaSimbolo}" FontSize="13" />
                                                <Span Text=" " />
                                                <Span Text="{Binding Balance, StringFormat='{0:N2}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </dx:DXBorder>

                            <!-- Botón Pago -->
                            <dx:DXButton
                                CornerRadius="12"
                                HeightRequest="48"
                                Command="{Binding PagoCommand}">
                                <Label
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    HorizontalTextAlignment="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding CantidadTotalItems}" />
                                            <Span Text=" Items = " />
                                            <Span Text="{Binding MonedaSimbolo}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Balance, StringFormat='{0:N2}'}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </dx:DXButton>

                            <!-- Botón Clonar -->
                            <dx:DXButton
                                CornerRadius="12"
                                HeightRequest="48"
                                BackgroundColor="#43A047"
                                IsVisible="{Binding MostrarClonar}"
                                Command="{Binding ClonarCommand}">
                                <Label
                                    Text="Clonar Producto"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    FontSize="15"
                                    HorizontalTextAlignment="Center" />
                            </dx:DXButton>
                        </StackLayout>
                    </dx:DXBorder>
                </Grid>
            </dxc:ShimmerView.Content>
            <dxc:ShimmerView.LoadingView>
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   HeightRequest="50"
                                   WidthRequest="50" />
            </dxc:ShimmerView.LoadingView>
        </dxc:ShimmerView>
    </ContentPage.Content>
</ContentPage>
